root = true

[*]
indent_style = space
insert_final_newline = true
charset = utf-8
end_of_line = lf

# Windows command scripts keep CRLF, as in .gitattributes.
[*.{cmd,bat}]
end_of_line = crlf

[*.{csproj,props,targets,slnx,xml,config,nuspec,json}]
indent_size = 2

[*.{cs,ts,mts,js,mjs}]
max_line_length = 120

[*.{ts,mts,js,mjs}]
indent_size = 2

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:silent
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:silent
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Analyzer severity overrides (agree each one before adding it; say why).
# Callers must forward cancellation or explicitly opt out.
dotnet_diagnostic.CA2016.severity = error

# RSEXPERIMENTAL006 = none, generator sources only (agreed with the user on 2026-11-13).
# Roslyn's closed-type API (ITypeSymbol.IsClosed, GetClosedDerivedTypeInfo) is [Experimental] in
# Microsoft.CodeAnalysis 5.9. It is the reliable way to read C# 15 closed error hierarchies from both source and
# metadata. Pin the Roslyn version, cover the API with generator tests, and revisit when it is stable.
[src/Spar.Generator/**.cs]
dotnet_diagnostic.RSEXPERIMENTAL006.severity = none

# MSBuild task sources (agreed with the user on 2026-11-14; docs/evidence/msbuild-task-analyzer).
# The task project is not created yet: keep this path in step with its folder when M1 adds it.
# - run_mt_analyzers_on_all_tasks: a task that forgets [MSBuildMultiThreadableTask] still gets the thread-safety
#   rules MSBuildTask0002-0005 instead of 0001 only.
# - MSBuildTask0001 and 0011 are Info, which never shows in a command-line build, so a task calling Console,
#   Environment.Exit or SetCurrentDirectory, or a task without the full thread-safe shape, would compile silently.
#   MSBuildTask0013 is off by default. As warnings they fail the build under TreatWarningsAsErrors.
# - MSBuildTask0009 (Info): a typed parameter (ITaskItem<T>) whose type MSBuild cannot parse fails only at run time,
#   when the task is bound. MSBuildTask0010 (culture-invariant parsing of typed parameters) stays Info: it is advice,
#   and invariant parsing is what build tasks want.
# A probe confirmed that a path-scoped section here carries both the option and the severities.
[src/Spar.Sdk.Tasks/**.cs]
msbuild_task_analyzer.run_mt_analyzers_on_all_tasks = true
dotnet_diagnostic.MSBuildTask0001.severity = warning
dotnet_diagnostic.MSBuildTask0011.severity = warning
dotnet_diagnostic.MSBuildTask0013.severity = warning
dotnet_diagnostic.MSBuildTask0009.severity = warning
