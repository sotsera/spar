<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Spar runtime: results, contract attributes, the app builder and command dispatch. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The Spar runtime: contracts, results, the app builder and command dispatch.</Description>
    <RootNamespace>Spar</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The packed page is read in place from the image (Hosting/SparFrontend.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spar.Loopback" />
    <InternalsVisibleTo Include="Spar.Windows" />
    <InternalsVisibleTo Include="Spar.Linux" />
    <InternalsVisibleTo Include="Spar.Testing" />
    <InternalsVisibleTo Include="Spar.Testing.Browser" />
    <InternalsVisibleTo Include="Spar.Tests" />
    <InternalsVisibleTo Include="Spar.Sdk.Tasks.Tests" />

    <!-- The window tests drive the test window's lifetime (Testing/SparTestWindow.cs) for the required host tests. -->
    <InternalsVisibleTo Include="Spar.WindowTests" />

    <!-- The console harness hosts the bridge the way a desktop host will (tests/apps/Spar.Harness). -->
    <InternalsVisibleTo Include="Spar.Harness" />
  </ItemGroup>
</Project>
