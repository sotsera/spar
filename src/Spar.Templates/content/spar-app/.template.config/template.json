{
  "$schema": "http://json.schemastore.org/template",
  "author": "Spar",
  "classifications": [
    "Desktop",
    "Windows",
    "Linux",
    "Spar"
  ],
  "identity": "Spar.Templates.App.CSharp",
  "groupIdentity": "Spar.Templates.App",
  "name": "Spar desktop app",
  "shortName": "spar-app",
  "description": "A desktop app for Windows and Linux: a C# backend and a React + TypeScript + Vite page in one window, with its fast tests and its end-to-end tests (browser, window and the published executable).",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "preferNameDirectory": true,
  "symbols": {
    "appName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safeNamespace",
      "replaces": "MyApp",
      "fileRename": "MyApp"
    },
    "appNameLower": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerSafeNamespace",
      "replaces": "myapp"
    },
    "platforms": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Platforms",
      "description": "The OSes the app runs on. Written as SparPlatforms in the app's project.",
      "choices": [
        {
          "choice": "both",
          "displayName": "Windows and Linux",
          "description": "Windows and Linux (SparPlatforms windows;linux)."
        },
        {
          "choice": "windows",
          "displayName": "Windows",
          "description": "Windows only (SparPlatforms windows)."
        },
        {
          "choice": "linux",
          "displayName": "Linux",
          "description": "Linux only (SparPlatforms linux)."
        }
      ],
      "defaultValue": "both"
    },
    "sparPlatforms": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(platforms == 'windows')",
            "value": "windows"
          },
          {
            "condition": "(platforms == 'linux')",
            "value": "linux"
          },
          {
            "condition": "",
            "value": "windows;linux"
          }
        ]
      },
      "replaces": "windows;linux",
      "onlyIf": [
        {
          "after": "<SparPlatforms>"
        }
      ]
    },
    "AppId": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "App id",
      "description": "The app's id, SparAppId: reverse-DNS (two or more parts separated by dots, each of ASCII letters, digits and underscores, not starting with a digit), unique to this app; it names the app to the OS and its per-user folders. Default: com.example.<name>, which a real app replaces with a domain it owns."
    },
    "defaultAppId": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "appIdFromName"
    },
    "appIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "AppId",
        "fallbackVariableName": "defaultAppId"
      },
      "replaces": "com.example.MyApp"
    },
    "NoEndToEndTests": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "No end-to-end tests",
      "description": "Leaves out the end-to-end test project (<name>.EndToEndTests, with the browser, window and black-box tests). The app and its fast tests are always created.",
      "defaultValue": "false"
    },
    "dotnetSdkVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "PACKED_DOTNET_SDK_VERSION"
      },
      "replaces": "SPAR_DOTNET_SDK_VERSION"
    },
    "sparSdkVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "PACKED_SPAR_SDK_VERSION"
      },
      "replaces": "SPAR_SDK_VERSION"
    }
  },
  "forms": {
    "safeNamespace": {
      "identifier": "safe_namespace"
    },
    "lowerSafeNamespace": {
      "identifier": "lower_safe_namespace"
    },
    "appIdFromName": {
      "identifier": "chain",
      "steps": [
        "appIdAsciiParts",
        "appIdNoLeadingDigit",
        "appIdPrefix"
      ]
    },
    "appIdAsciiParts": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_.]",
      "replacement": "_"
    },
    "appIdNoLeadingDigit": {
      "identifier": "replace",
      "pattern": "(^|[.])([0-9])",
      "replacement": "$1_$2"
    },
    "appIdPrefix": {
      "identifier": "replace",
      "pattern": "^",
      "replacement": "com.example."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(NoEndToEndTests)",
          "exclude": [
            "MyApp.EndToEndTests/**"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "MyApp.slnx"
    }
  ]
}
