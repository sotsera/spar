<Project Sdk="Spar.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Names the app to the OS and its per-user folders: reverse-DNS, unique to this app. -->
    <SparAppId>com.example.MyApp</SparAppId>
  </PropertyGroup>

  <!-- Every warning fails the build, the compiler's and MSBuild's, the SDK's and NuGet's. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>
</Project>
