<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/Spar.Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PlatformTarget>x64</PlatformTarget>
    <PackageId>Sotsera.Spar.Windows</PackageId>
    <PackageId Condition="'$(Configuration)' == 'Debug'">Sotsera.Spar.Windows.Development</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sotsera.Spar.Bridge/Sotsera.Spar.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbeddedResource Include="Inspection.js" LogicalName="Spar.Inspection.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true"
                      IncludeAssets="none" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_Web_WebView2)/build/native/x64/WebView2Loader.dll"
          Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt"
          Link="WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="licenses/WebView2-LICENSE.txt" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/NOTICE.txt"
          Link="WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="licenses/WebView2-NOTICE.txt" />
    <None Include="../../build/Spar.NativePackage.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
  </ItemGroup>

</Project>
