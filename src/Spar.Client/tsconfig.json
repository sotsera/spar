{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "sourceRoot": "src/",
    "rootDir": "src",
    "outDir": "obj/dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/vite"
  ]
}
