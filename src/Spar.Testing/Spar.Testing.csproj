    <RootNamespace>Spar.Testing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spar\Spar.csproj" />
    <ProjectReference Include="..\Spar.Loopback\Spar.Loopback.csproj" />
  </ItemGroup>
</Project>
