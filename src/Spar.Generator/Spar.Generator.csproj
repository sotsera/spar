<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The contract generator and its analyzer (plan section 2): dispatch, serializers, the catalog, the Create
    interceptor, and in the Test variant the test entry point and typed test clients. Targets the Roslyn of the oldest
    supported IDE, not the SDK's own compiler.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- One rule for a CSP source, at build time (SPAR104) and at run time (CspBuilder). -->
  <ItemGroup>
    <Compile Include="..\Spar\Hosting\CspSourceRule.cs" Link="Shared\CspSourceRule.cs" />
  </ItemGroup>

  <!-- The client step runs this same analysis before the compile (plan section 1, pipeline step 3). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Spar.Sdk.Tasks" />
    <InternalsVisibleTo Include="Spar.Sdk.Tasks.Tests" />
  </ItemGroup>
</Project>
