<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generators target the Roslyn shipped with the oldest supported IDE, not the SDK's own compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <!-- 18.13.0 is the only version published; the task project references it with PrivateAssets="all". -->
    <PackageVersion Include="Microsoft.Build.TaskAuthoring.Analyzer" Version="18.13.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!--
      The Windows host (src/Spar.Windows): CsWin32 generates its Win32 declarations; the WebView2 package is used only
      for its loader (static library under NativeAOT, DLL on CoreCLR) and its header, never for its managed API.
    -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.369" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- The NativeAOT test lane (plan section 5): the same tests against xUnit's source-generated flavour. -->
    <PackageVersion Include="xunit.v3.aot" Version="4.0.3" />
  </ItemGroup>
</Project>
