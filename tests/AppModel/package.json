{
  "name": "spar-app-model-check",
  "private": true,
  "type": "module",
  "scripts": {
    "verbatim": "node tools/extract-blocks.mjs --check",
    "contracts": "node tools/check-contracts.mjs",
    "check:ts7": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "check:ts6": "node node_modules/typescript6/bin/tsc -p tsconfig.json",
    "bad:ts7": "node tools/check-bad.mjs typescript",
    "bad:ts6": "node tools/check-bad.mjs typescript6",
    "check": "npm run verbatim && npm run contracts && npm run check:ts7 && npm run check:ts6 && npm run bad:ts7 && npm run bad:ts6 && npm run routing",
    "routing": "node --experimental-strip-types --no-warnings tools/failure-routing.mts"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3"
  }
}
