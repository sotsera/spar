# The contracts of SqlTool.Real as pages see them. Written by the build; commit it with the change.
# CI builds fail with SPAR100 when it is out of date.

fingerprint e2108e74156633cf

contract connections (SqlTool.Connections.IConnections)
  forget(string) -> void
  list() -> IReadOnlyList<SqlTool.Connections.ConnectionInfo>
  test(string) -> SqlTool.Connections.ConnectionInfo | SqlTool.Connections.ConnectionError

contract copyJobs (SqlTool.CopyJobs.CopyJobsService)
  cancelAll() -> void
  plan(SqlTool.CopyJobs.CopyRecipe) -> SqlTool.CopyJobs.CopyPlan | SqlTool.CopyJobs.PlanError
  preview(SqlTool.CopyJobs.CopyRecipe) -> stream of SqlTool.CopyJobs.PreviewRow
  progress(string) -> subscription of SqlTool.CopyJobs.CopyProgress
  run(SqlTool.CopyJobs.RunCopy) -> SqlTool.CopyJobs.CopyReport | SqlTool.CopyJobs.RunError

contract crashReport (SqlTool.Status.CrashReport)
  lastCrash() -> SqlTool.Status.CrashInfo?

contract csvExport (SqlTool.Recipes.CsvExportService)
  export(SqlTool.Recipes.ExportRequest) -> int | SqlTool.Recipes.ExportError

contract preferences (SqlTool.Settings.PreferencesService)
  get() -> SqlTool.Settings.ToolSettings
  setBatchSize(int) -> SqlTool.Settings.ToolSettings

contract recipes (SqlTool.Recipes.RecipesService)
  import() -> SqlTool.Recipes.RecipeInfo | SqlTool.Recipes.ImportError

contract reports (SqlTool.Reports.ReportsService)
  activityChart(SqlTool.Reports.ChartKey) -> resource of Spar.SparBlob?
  exportCopy(string) -> Spar.SparBlob

contract savedConnections (SqlTool.Connections.SavedConnectionsService)
  forget(string) -> void | SqlTool.Connections.SavedConnectionError
  hasPassword(string) -> bool
  save(SqlTool.Connections.SaveConnection) -> void | SqlTool.Connections.SavedConnectionError

contract script (SqlTool.Scripts.ScriptService)
  copyCreateScript(string) -> void | SqlTool.Scripts.CopyScriptError

contract status (SqlTool.Status.StatusService)
  disk() -> Spar.DiskUsage | Spar.FileAccessError
  memory() -> subscription of Spar.MemoryUsage (latest only)

record Spar.DiskUsage
  profileBytes: long
  appDataBytes: long
  cacheBytes: long

record Spar.MemoryUsage
  totalBytes: long
  engineBytes: long
  appBytes: long
  engine: IReadOnlyList<Spar.ProcessMemory>

record Spar.ProcessMemory
  kind: string
  bytes: long

record SqlTool.Connections.ConnectionInfo
  id: string
  server: string
  database: string
  integratedSecurity: bool

record SqlTool.Connections.SaveConnection
  name: string
  server: string
  user: string
  password: string

record SqlTool.CopyJobs.CopyPlan
  planId: Guid
  steps: IReadOnlyList<SqlTool.CopyJobs.PlanStep>

record SqlTool.CopyJobs.CopyProgress
  jobId: string
  rows: long

record SqlTool.CopyJobs.CopyRecipe
  source: string
  target: string
  tables: IReadOnlyList<string>

record SqlTool.CopyJobs.CopyReport
  tables: int
  rows: long
  elapsed: TimeSpan

record SqlTool.CopyJobs.PlanStep
  table: string
  estimatedRows: long

record SqlTool.CopyJobs.PreviewRow
  cells: IReadOnlyList<string?>

record SqlTool.CopyJobs.RunCopy
  planId: Guid
  truncateTarget: bool

record SqlTool.Recipes.ExportRequest
  tables: IReadOnlyList<string>

record SqlTool.Recipes.RecipeInfo
  name: string
  tables: int

record SqlTool.Reports.ChartKey
  server: string
  minutes: int

record SqlTool.Settings.ToolSettings
  batchSize: int
  previewRows: int
  lastRecipe: string?

record SqlTool.Status.CrashInfo
  at: DateTimeOffset
  summary: string

error Spar.FileAccessError
  notFound
  accessDenied
  inUse
  tooLarge(limit: int)
  grantExpired
  outsideFolder(path: string)
  readOnlyGrant
  failed(reason: string)

error SqlTool.Connections.ConnectionError
  notFound(connectionId: string)
  loginFailed(server: string, sqlNumber: int)

error SqlTool.Connections.SavedConnectionError
  noPasswordStore(reason: string)
  passwordTooLong(limit: int)
  notSaved

error SqlTool.CopyJobs.PlanError
  connectionNotFound(connectionId: string)
  tableMissing(connection: string, table: string)

error SqlTool.CopyJobs.RunError
  planOutdated(reason: string)
  targetNotEmpty(table: string, rows: long)
  partiallyCopied(rowsCommitted: long, reason: string)

error SqlTool.Recipes.ExportError
  dismissed
  noFolder(reason: string)
  writeFailed(file: string)

error SqlTool.Recipes.ImportError
  dismissed
  notAllowed(path: string)
  noFileDialog(reason: string)
  tryAgain
  unreadable(file: string)

error SqlTool.Scripts.CopyScriptError
  clipboardBusy
  scriptTooLarge(limit: long)
  noClipboard(reason: string)
