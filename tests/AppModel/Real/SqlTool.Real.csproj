<Project Sdk="Spar.Sdk">
  <!--
    The document's app built by real Spar (decision "The documentation check under tests/"): its C# blocks, as the
    stand-in check copied them, through Spar's SDK, analyzer and generator, with stand-ins (../Planned) only for the
    APIs Spar does not have yet. Left out until Spar can build them: the contracts with streams and subscriptions
    (copyJobs, status, M3), those with file grants (recipes, csvExport), and the deliberately failing files.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlTool</RootNamespace>
    <SparAppId>com.example.SqlTool</SparAppId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SqlTool\**\*.cs" LinkBase="SqlTool"
             Exclude="..\SqlTool\bin\**;..\SqlTool\obj\**;..\SqlTool\Failing\**;..\SqlTool\CopyJobs\CopyJobsService.cs;..\SqlTool\Status\StatusService.cs;..\SqlTool\Recipes\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Planned\Spar.Planned.csproj" />
  </ItemGroup>
</Project>
