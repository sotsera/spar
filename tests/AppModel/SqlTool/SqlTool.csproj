<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SqlTool</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spar.Stubs\Spar.Stubs.csproj" />
  </ItemGroup>

  <!-- The stand-in end-to-end project reaches Program, as a test project does through the Test variant. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SqlTool.EndToEndTests" />
  </ItemGroup>

  <!--
    Failing/ holds code that must not compile. Each file is compiled only when its switch is set:
    -p:SparCheckMissingCase=true  a PlanError switch and a file-dialog switch, each with one case missing (expected CS8509 twice)
  -->
  <ItemGroup>
    <Compile Remove="Failing/**" />
    <Compile Include="Failing/ExhaustiveMissingCase.cs" Condition="'$(SparCheckMissingCase)' == 'true'" />
    <Compile Include="Failing/FileDialogMissingCase.cs" Condition="'$(SparCheckMissingCase)' == 'true'" />
  </ItemGroup>
</Project>
