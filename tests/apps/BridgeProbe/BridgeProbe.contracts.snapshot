# The contracts of BridgeProbe as pages see them. Written by the build; commit it with the change.
# CI builds fail with SPAR100 when it is out of date.

fingerprint aacf13bebd015c6c

contract probe (BridgeProbe.ProbeService)
  echo(string) -> string
  frame() -> string
  note(string) -> void
  plan() -> BridgeProbe.Plan
  steps() -> string

record BridgeProbe.Plan
  steps: string
  load: int
