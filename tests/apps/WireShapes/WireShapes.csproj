<Project Sdk="Spar.Sdk">
  <!--
    A test app whose one contract echoes every wire shape the generator supports, for run-time serializer tests. It also
    serves the contract of a library it references, which it lists in SparContracts.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WireShapes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WireShapes.Library\WireShapes.Library.csproj" />
    <SparContracts Include="WireShapes.Library" />
  </ItemGroup>
</Project>
