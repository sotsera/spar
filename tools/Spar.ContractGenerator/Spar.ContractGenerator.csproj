<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ClientRuntime.js" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Resolve the selected SDK after its imports. Visual Studio's MSBuildToolsPath is not the .NET SDK. -->
  <PropertyGroup>
    <SparCompilerDirectory>$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Roslyn/bincore</SparCompilerDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(SparCompilerDirectory)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(SparCompilerDirectory)/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>

</Project>
