<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Packages come from nuget.org, except Spar.Sdk, which comes from eng/source-sdk/feed: the 0.0.0-source package that
    lets this repository's projects write <Project Sdk="Spar.Sdk"> (eng/source-sdk/Sdk/Sdk.props).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="spar-source-sdk" value="eng/source-sdk/feed" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="spar-source-sdk">
      <package pattern="Spar.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
