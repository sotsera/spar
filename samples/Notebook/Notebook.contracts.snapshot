# The contracts of Notebook as pages see them. Written by the build; commit it with the change.
# CI builds fail with SPAR100 when it is out of date.

fingerprint 8348cfb9dd82e4d5

contract images (Notebook.Pages.ImagesService)
  add(Notebook.Pages.AddImage) -> Notebook.Pages.ImageRef | Notebook.Pages.ImageError
  addFile(Notebook.Pages.AddImageFile) -> Notebook.Pages.ImageRef | Notebook.Pages.ImageError
  image(Notebook.Pages.ImageRef) -> resource of Spar.SparBlob?

contract pages (Notebook.Pages.PagesService)
  changes() -> subscription of Notebook.Pages.PageChange
  create(Notebook.Pages.CreatePage) -> Notebook.Pages.Page | Notebook.Pages.PageError
  delete(Notebook.Pages.PageRef) -> void | Notebook.Pages.PageError
  get(Notebook.Pages.PageRef) -> Notebook.Pages.Page | Notebook.Pages.PageError
  list() -> IReadOnlyList<Notebook.Pages.PageSummary>
  save(Notebook.Pages.SavePage) -> Notebook.Pages.Page | Notebook.Pages.PageError

contract preferences (Notebook.Pages.PreferencesService)
  get() -> Notebook.Pages.NotebookSettings
  setLastPage(string?) -> void
  setViewMode(Notebook.Pages.ViewMode) -> void

contract transfer (Notebook.Pages.TransferService)
  copy(Notebook.Pages.PageRef) -> void | Notebook.Pages.CopyError
  export(Notebook.Pages.PageRef) -> string | Notebook.Pages.ExportError
  import(Notebook.Pages.ImportFiles) -> IReadOnlyList<Notebook.Pages.Imported>

record Notebook.Pages.AddImage
  pageId: string
  contentType: string
  bytes: byte[]

record Notebook.Pages.AddImageFile
  pageId: string
  file: Spar.FileGrant

record Notebook.Pages.CreatePage
  title: string
  markdown: string?

record Notebook.Pages.ImageRef
  pageId: string
  imageId: string

record Notebook.Pages.ImportFiles
  files: IReadOnlyList<Spar.FileGrant>

record Notebook.Pages.Imported
  fileName: string
  pageId: string?
  problem: string?

record Notebook.Pages.NotebookSettings
  viewMode: Notebook.Pages.ViewMode
  lastPage: string?

record Notebook.Pages.Page
  id: string
  title: string
  markdown: string
  updatedAt: DateTimeOffset
  revision: long

record Notebook.Pages.PageChange
  id: string
  kind: Notebook.Pages.PageChangeKind
  revision: long

record Notebook.Pages.PageRef
  id: string

record Notebook.Pages.PageSummary
  id: string
  title: string
  updatedAt: DateTimeOffset

record Notebook.Pages.SavePage
  id: string
  markdown: string
  baseRevision: long

error Notebook.Pages.CopyError
  busy
  notCopied(reason: string)
  notFound(id: string)

error Notebook.Pages.ExportError
  dismissed
  notSaved(reason: string)
  notFound(id: string)

error Notebook.Pages.ImageError
  pageNotFound(id: string)
  notAnImage(contentType: string)
  tooLarge(maxBytes: int)

error Notebook.Pages.PageError
  titleTaken(title: string)
  invalidTitle(reason: string)
  notFound(id: string)
  changedElsewhere(currentRevision: long)

enum Notebook.Pages.PageChangeKind
  Created, Saved, Deleted

enum Notebook.Pages.ViewMode
  Write, Split, Read
