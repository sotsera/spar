<Project Sdk="Spar.Sdk">
  <!--
    The Notebook sample: a local Markdown notebook (decision "Polished sample apps: a Markdown notebook; the test
    variant"). It names Spar.Sdk as an app does; in this repository that SDK is the 0.0.0-source package, which builds
    against Spar's sources (eng/source-sdk).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Notebook</RootNamespace>
    <SparAppId>com.example.Notebook</SparAppId>
  </PropertyGroup>

  <!-- Traces, metrics and logs over OTLP when OTEL_EXPORTER_OTLP_ENDPOINT is set (docs/guide/telemetry.md). -->
  <ItemGroup>
    <PackageReference Include="Spar.OpenTelemetry" />
  </ItemGroup>
</Project>
