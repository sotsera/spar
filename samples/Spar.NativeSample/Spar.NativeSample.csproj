<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <DefaultItemExcludes>$(DefaultItemExcludes);frontend/**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="../../build/Spar.Delivery.targets" />

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SparProductionAssets>true</SparProductionAssets>
    <SparFrontendDirectory>$(MSBuildProjectDirectory)/frontend</SparFrontendDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sotsera.Spar.Windows/Sotsera.Spar.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DotNetWatchBuild)' != 'true'">
    <ProjectReference Include="../Spar.NativeSample.Contracts/Spar.NativeSample.Contracts.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;PublishAot;SelfContained" />
  </ItemGroup>

  <!-- The patch workspace sees an immutable contract binary, not its editable source project. -->
  <Target Name="SparUseCompiledContracts" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DotNetWatchBuild)' == 'true'">
    <ItemGroup>
      <Reference Include="Spar.NativeSample.Contracts">
        <HintPath>$(TargetDir)Spar.NativeSample.Contracts.dll</HintPath>
      </Reference>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="../../src/Sotsera.Spar.Development/Sotsera.Spar.Development.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Program.Development.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Remove="Program.Production.cs" />
  </ItemGroup>

  <Import Project="../../build/Spar.Assets.targets" Condition="'$(SparProductionAssets)' == 'true'" />
</Project>
