<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <SparContractFile>$(MSBuildProjectDirectory)/BackendContract.cs</SparContractFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sotsera.Spar.Windows/Sotsera.Spar.Windows.csproj" />
    <ProjectReference Include="../../tools/Spar.ContractGenerator/Spar.ContractGenerator.csproj"
                      ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;PublishAot;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="App.html" LogicalName="Spar.Sample.App.html" />
    <EmbeddedResource Include="App.js" LogicalName="Spar.Sample.App.js" />
    <EmbeddedResource Include="Probe.js" LogicalName="Spar.Sample.Probe.js" />
  </ItemGroup>

  <Import Project="../../build/Spar.Contracts.targets" />

</Project>
