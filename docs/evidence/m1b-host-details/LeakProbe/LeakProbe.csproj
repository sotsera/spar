<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The teardown leak probe of docs/evidence/m1b-host-details.md: built from a copy outside the repository by
    leak.sh, which copies Spar's hand-declared WebView2 interfaces (src/Spar.Windows/Interop) into Interop/ beside it,
    so the probe calls WebView2 exactly as the host does. Published as NativeAOT, with WebView2Loader.dll beside it,
    so the same executable runs on the desktop and in Windows Sandbox. Not part of Spar.slnx.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LeakProbe</RootNamespace>
    <!-- Native.Startup.cs uses CsWin32-free SafeHandle imports only; nothing else of the host is needed. -->
  </PropertyGroup>
</Project>
