<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Keep local Debug PDB paths consistent with the editor's project paths.
         Git source-root mapping changes drive-letter casing on this Windows checkout. -->
    <EnableSourceControlManagerQueries Condition="'$(Configuration)' == 'Debug'">false</EnableSourceControlManagerQueries>
  </PropertyGroup>

</Project>
