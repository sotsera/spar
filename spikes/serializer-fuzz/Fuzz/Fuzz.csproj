<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fuzz</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Keep generated sources on disk (under obj/) for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- dotnet publish -p:FuzzAot=true: NativeAOT build of the same harness (a global PublishAot would reach the netstandard generators). -->
  <PropertyGroup Condition="'$(FuzzAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Original: verbatim copy of the serializer-bench generator. Fixed: the same copy with the fuzz fixes applied. -->
    <ProjectReference Include="..\Fuzz.Generator.Original\Fuzz.Generator.Original.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fuzz.Generator.Fixed\Fuzz.Generator.Fixed.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fuzz.Runtime\Fuzz.Runtime.csproj" />
    <None Include="js-check.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
