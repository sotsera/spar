  "type": "module",
  "scripts": {
    "check": "tsc -p forms/a-method/tsconfig.app.json && tsc -p forms/b-function/tsconfig.app.json && tsc -p forms/c-call/tsconfig.app.json && tsc -p forms/b-proto/tsconfig.app.json && tsc -p bench",
    "check:vscode": "node tools/check-vscode-ts.ts",
    "probe": "node tools/probe.ts all",
    "size": "node bench/build.ts",
