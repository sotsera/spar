    "behaviour": "node bench/build.ts behaviour && node obj/bundle/behaviour.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "rolldown": "1.2.19",
    "typescript": "7.0.2"
  }
}
