{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm",
    "cache": {
      "path": "../obj/angular-cache"
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "spike": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "styles": [
              "src/styles.css"
            ],
            "assets": [],
            "outputPath": "../../../artifacts/frontend-frameworks/angular-zoneless",
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": false
            },
            "outputHashing": "all",
            "sourceMap": false
          },
          "configurations": {
            "default-optimization": {
              "outputPath": "../../../artifacts/frontend-frameworks/angular-default-optimization",
              "optimization": true
            },
            "zone": {
              "browser": "src/main-zone.ts",
              "polyfills": [
                "zone.js"
              ],
              "outputPath": "../../../artifacts/frontend-frameworks/angular-zone"
            },
            "jit": {
              "aot": false,
              "outputPath": "../../../artifacts/frontend-frameworks/angular-jit"
            },
            "csp-clean": {
              "index": {
                "input": "src/index.clean.html",
                "output": "index.html"
              },
              "outputPath": "../../../artifacts/frontend-frameworks/angular-csp-clean",
              "fileReplacements": [
                {
                  "replace": "src/component-styles.ts",
                  "with": "src/component-styles.clean.ts"
                }
              ]
            }
          }
        }
      }
    }
  }
}
