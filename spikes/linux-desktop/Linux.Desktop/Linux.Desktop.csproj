<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike Linux desktop host: a GTK window with a WebKitGTK view, through source-generated P/Invoke only.
    -p:SparGtk=4 builds against GTK4 + WebKitGTK 6.0; the default is GTK3 + WebKitGTK 4.1.
  -->
  <PropertyGroup>
    <RootNamespace>Linux.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SparGtk)' == '4'">
    <DefineConstants>$(DefineConstants);SPAR_GTK4</DefineConstants>
  </PropertyGroup>

  <!-- The in-process self-test (journey, bench driver, snapshot) exists only when asked for. -->
  <PropertyGroup Condition="'$(SparSelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);SPAR_SELFTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../d1-pipeline/Spike.Runtime/Spike.Runtime.csproj" />
  </ItemGroup>
</Project>
