<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Resource-usage spike, Linux host: GTK 4 + WebKitGTK 6.0 only. Native imports and the GLib context are copied from
    spikes/webview-profiles. The pages (../www) are served from disk.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.ResourceUsage</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
