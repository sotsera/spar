<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WebView2 profile and shutdown spike. One NativeAOT executable with two verbs: "host" (the app under test, one or
    more offscreen windows) and "harness" (runs host processes, watches their browser processes, writes results).
    Window, environment and asset-serving pieces are copied from spikes/desktop-origin.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.WebViewProfiles</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The probe page is shared with the Linux host, which serves the same folder from disk. -->
    <EmbeddedResource Include="../www/**" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
</Project>
