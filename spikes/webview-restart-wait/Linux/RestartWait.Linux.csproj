<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Linux probe of spikes/webview-restart-wait: GTK4 + WebKitGTK 6.0, hand-written imports, NativeAOT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>RestartWait.Linux</RootNamespace>
  </PropertyGroup>
</Project>
