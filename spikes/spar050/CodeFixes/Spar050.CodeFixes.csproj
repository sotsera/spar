<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Code fixes for SPAR050, SPAR051 and SPAR053. A separate assembly because it needs the Workspaces layer, which an
    analyzer assembly must not reference (RS1038). Both ship in Spar.Sdk's analyzers/dotnet/cs folder.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Spar.Analyzers.CodeFixes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Analyzers\Spar050.Analyzers.csproj" />
  </ItemGroup>
</Project>
