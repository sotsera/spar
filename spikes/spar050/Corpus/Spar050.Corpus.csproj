<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The probe corpus. Every file under Cases/ is one case; markers give the expected diagnostics (see RESULTS.md).
    -p:Analyzer=Baseline|New|None picks the analyzer. -p:CaseGlob=… narrows the cases (one build per error case).
  -->
  <PropertyGroup>
    <Analyzer Condition="'$(Analyzer)' == ''">New</Analyzer>
    <CaseGlob Condition="'$(CaseGlob)' == ''">Cases\**\*.cs</CaseGlob>
    <CaseSet Condition="'$(CaseSet)' == ''">all</CaseSet>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IntermediateOutputPath>obj\$(Configuration)\$(Analyzer)-$(CaseSet)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(Analyzer)-$(CaseSet)\</OutputPath>
    <ErrorLog>$(IntermediateOutputPath)diagnostics.sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Shared\**\*.cs" />
    <Compile Include="$(CaseGlob)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Result\Spar050.Result.csproj" />
    <ProjectReference Include="..\CorpusLibrary\Spar050.CorpusLibrary.csproj" />
    <ProjectReference Include="..\CorpusGenerator\Spar050.CorpusGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Analyzer)' == 'Baseline'">
    <ProjectReference Include="..\Baseline\Spar050.Baseline.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Analyzer)' == 'New'">
    <ProjectReference Include="..\Analyzers\Spar050.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
