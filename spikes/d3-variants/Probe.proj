<Project>
  <!--
    Probes of in-proc variant builds that Variant.targets does not exercise. Run with dotnet msbuild Probe.proj -t:<Name>.
    P (default DesktopTest), Rid (default win-x86) and Session select the global properties.
  -->
  <PropertyGroup>
    <AppProject>$(MSBuildThisFileDirectory)App\App.csproj</AppProject>
    <P Condition="'$(P)' == ''">SparVariant=Development;Configuration=Debug</P>
    <Rid Condition="'$(Rid)' == ''">win-x86</Rid>
  </PropertyGroup>

  <!-- A RuntimeIdentifier the project's restore did not include, built without restoring for it. -->
  <Target Name="RidWithoutRestore">
    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(P);RuntimeIdentifier=$(Rid)" />
  </Target>

  <!-- The same, restoring first in a separate evaluation. -->
  <Target Name="RidWithRestore">
    <MSBuild Projects="$(AppProject)" Targets="Restore"
             Properties="$(P);RuntimeIdentifier=$(Rid);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(P);RuntimeIdentifier=$(Rid)" />
  </Target>

  <!-- Restore and build in the same project instance (identical global properties): the build reuses the
       evaluation made before the restore wrote nuget.g.props/targets. -->
  <Target Name="RestoreSameEvaluation">
    <MSBuild Projects="$(AppProject)" Targets="Restore;Build" Properties="$(P)" />
  </Target>

  <!-- Build an unrestored variant with no restore call at all. -->
  <Target Name="NoRestore">
    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(P)" />
  </Target>

  <!-- Two calls with identical global properties in one build: the second is served from the results cache. -->
  <Target Name="Twice">
    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(P)" />
    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(P)" />
  </Target>
</Project>
