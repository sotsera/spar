<Project>
  <!--
    Imported by the test projects. After the test project builds, it builds the app in another variant.
      D3VariantMode      InProc (MSBuild task, default) | Exec (nested dotnet process) | None
      D3VariantOperation Build (default) | Publish (NativeAOT, win-x64)
      D3RestoreSession   Guid (default: a new MSBuildRestoreSessionId per call) | Fixed (a constant id)
  -->
  <PropertyGroup>
    <D3VariantMode Condition="'$(D3VariantMode)' == ''">InProc</D3VariantMode>
    <D3VariantOperation Condition="'$(D3VariantOperation)' == ''">Build</D3VariantOperation>
    <D3RestoreSession Condition="'$(D3RestoreSession)' == ''">Guid</D3RestoreSession>
    <D3Variant>DesktopTest</D3Variant>

    <D3AppDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'App'))</D3AppDir>
    <D3AppProject>$(D3AppDir)App.csproj</D3AppProject>

    <!-- Where each operation's variant executable lands; given to the tests relative to their output folder. -->
    <D3VariantBuildExe>$(D3AppDir)bin\$(D3Variant)\Debug\net11.0\App.exe</D3VariantBuildExe>
    <D3VariantPublishExe>$(D3AppDir)bin\$(D3Variant)\Release\net11.0\win-x64\publish\App.exe</D3VariantPublishExe>
    <D3ProductionBuildDll>$(D3AppDir)bin\Production\Debug\net11.0\App.dll</D3ProductionBuildDll>
  </PropertyGroup>

  <!-- Global properties of the variant build. Both modes pass exactly these. -->
  <PropertyGroup Condition="'$(D3VariantOperation)' == 'Build'">
    <_D3VariantProperties>SparVariant=$(D3Variant);Configuration=Debug</_D3VariantProperties>
  </PropertyGroup>

  <PropertyGroup Condition="'$(D3VariantOperation)' == 'Publish'">
    <_D3VariantProperties>SparVariant=$(D3Variant);Configuration=Release;RuntimeIdentifier=win-x64;PublishAot=true;_IsPublishing=true</_D3VariantProperties>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The caller's own global properties flow into an MSBuild task call; drop the ones that must not. -->
    <_D3RemovedProperties>TargetFramework;RuntimeIdentifier;SelfContained;D3VariantMode;D3VariantOperation;D3RestoreSession;D3Lock</_D3RemovedProperties>
    <_D3RestoreSessionId Condition="'$(D3RestoreSession)' == 'Fixed'">d3-variant-restore</_D3RestoreSessionId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>D3VariantBuildExe</_Parameter1>
      <_Parameter2>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\$(OutputPath)', '$(D3VariantBuildExe)'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>D3VariantPublishExe</_Parameter1>
      <_Parameter2>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\$(OutputPath)', '$(D3VariantPublishExe)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    D3Lock=true: hold a cross-process lock (a FileShare.None lock file in the variant's obj) around the variant build.
    The open stream is a registered task object, so the release task (or the end of the build) closes it.
    Spike only: inline tasks; Spar would ship these in its compiled task assembly.
  -->
  <UsingTask TaskName="D3AcquireLock" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <LockFile ParameterType="System.String" Required="true" />
      <TimeoutSeconds ParameterType="System.Int32" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(LockFile));
        var watch = System.Diagnostics.Stopwatch.StartNew();
        var waited = false;
        while (true)
        {
            try
            {
                var stream = new System.IO.FileStream(LockFile, System.IO.FileMode.OpenOrCreate, System.IO.FileAccess.ReadWrite, System.IO.FileShare.None);
                ((Microsoft.Build.Framework.IBuildEngine4)BuildEngine).RegisterTaskObject("D3Lock|" + LockFile, stream, Microsoft.Build.Framework.RegisteredTaskObjectLifetime.Build, false);
                Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "D3: lock acquired after " + watch.ElapsedMilliseconds + " ms" + (waited ? " (waited)" : ""));
                break;
            }
            catch (System.IO.IOException) when (watch.Elapsed.TotalSeconds < TimeoutSeconds)
            {
                waited = true;
                System.Threading.Thread.Sleep(100);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="D3ReleaseLock" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <LockFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var engine = (Microsoft.Build.Framework.IBuildEngine4)BuildEngine;
        var stream = engine.UnregisterTaskObject("D3Lock|" + LockFile, Microsoft.Build.Framework.RegisteredTaskObjectLifetime.Build) as System.IDisposable;
        if (stream != null) stream.Dispose();
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <_D3LockFile>$(D3AppDir)obj\$(D3Variant)\variant.lock</_D3LockFile>
  </PropertyGroup>

  <Target Name="D3BuildVariantInProc" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(D3VariantMode)' == 'InProc'">
    <D3AcquireLock Condition="'$(D3Lock)' == 'true'" LockFile="$(_D3LockFile)" TimeoutSeconds="300" />

    <PropertyGroup>
      <_D3RestoreSessionId Condition="'$(D3RestoreSession)' != 'Fixed'">$([System.Guid]::NewGuid())</_D3RestoreSessionId>
    </PropertyGroup>

    <!-- Restore in its own evaluation (a distinct global property), so the next call evaluates fresh and sees
         the nuget.g.props/targets this restore wrote. -->
    <MSBuild Projects="$(D3AppProject)" Targets="Restore"
             Properties="$(_D3VariantProperties);MSBuildRestoreSessionId=$(_D3RestoreSessionId)"
             RemoveProperties="$(_D3RemovedProperties)" />

    <MSBuild Projects="$(D3AppProject)" Targets="$(D3VariantOperation)"
             Properties="$(_D3VariantProperties)" RemoveProperties="$(_D3RemovedProperties)" />

    <D3ReleaseLock Condition="'$(D3Lock)' == 'true'" LockFile="$(_D3LockFile)" />
    <Message Importance="high" Text="D3: in-proc $(D3VariantOperation) of $(D3Variant) done" />
  </Target>

  <Target Name="D3BuildVariantExec" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(D3VariantMode)' == 'Exec'">
    <PropertyGroup>
      <_D3ExecVerb>$(D3VariantOperation.ToLowerInvariant())</_D3ExecVerb>
      <_D3ExecProperties>-p:$(_D3VariantProperties.Replace(';', ' -p:'))</_D3ExecProperties>
    </PropertyGroup>

    <D3AcquireLock Condition="'$(D3Lock)' == 'true'" LockFile="$(_D3LockFile)" TimeoutSeconds="300" />
    <Exec Command="dotnet $(_D3ExecVerb) &quot;$(D3AppProject)&quot; $(_D3ExecProperties) -nologo -v:q" />

    <D3ReleaseLock Condition="'$(D3Lock)' == 'true'" LockFile="$(_D3LockFile)" />
    <Message Importance="high" Text="D3: exec $(D3VariantOperation) of $(D3Variant) done" />
  </Target>
</Project>
