<Project Sdk="Microsoft.NET.Sdk">
  <!--
    spikes/test-host/Spar.Mini.Testing, linked unchanged, except TestDataRoots.cs: the copy here takes the artifacts
    folder from SPIKE_ARTIFACTS (the Sandbox guest has no repository to search for).
  -->
  <PropertyGroup>
    <RootNamespace>Spar.Testing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <SpikeSource>..\..\..\test-host\Spar.Mini.Testing\</SpikeSource>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Spar.Mini\Spar.Mini.csproj" />
    <Compile Include="$(SpikeSource)**\*.cs" Exclude="$(SpikeSource)bin\**;$(SpikeSource)obj\**;$(SpikeSource)TestDataRoots.cs" LinkBase="Linked" />
  </ItemGroup>
</Project>
