<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Sandbox payload with real windows: spikes/test-host's NativeAOT test lane (the SampleApp.Tests sources linked
    unchanged, Playwright's browser tests left out), against xunit.v3.aot. One executable, no .NET needed in the guest.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>SampleApp.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);XUNIT_AOT</DefineConstants>
    <SpikeSource>..\..\..\test-host\SampleApp.Tests\</SpikeSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\SampleApp\SampleApp.csproj" />
    <ProjectReference Include="..\Spar.Mini.Testing\Spar.Mini.Testing.csproj" />
    <Compile Include="$(SpikeSource)*.cs" Exclude="$(SpikeSource)BrowserTests.cs" LinkBase="Tests" />
    <RuntimeHostConfigurationOption Include="Spar.TestHost.IsSupported" Value="true" Trim="true" />
  </ItemGroup>

  <Import Project="..\WebView2Loader.targets" />
</Project>
