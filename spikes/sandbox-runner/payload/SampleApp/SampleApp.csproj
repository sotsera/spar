<Project Sdk="Microsoft.NET.Sdk">
  <!-- spikes/test-host/SampleApp, linked unchanged (sources and page). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>SampleApp</RootNamespace>
    <SpikeSource>..\..\..\test-host\SampleApp\</SpikeSource>
    <SparTestHostSupported Condition="'$(SparTestHostSupported)' == ''">false</SparTestHostSupported>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spar.Mini\Spar.Mini.csproj" />
    <InternalsVisibleTo Include="SampleApp.Tests" />
    <InternalsVisibleTo Include="SampleApp.AotTests" />
    <Compile Include="$(SpikeSource)**\*.cs" Exclude="$(SpikeSource)bin\**;$(SpikeSource)obj\**" LinkBase="Linked" />
    <EmbeddedResource Include="$(SpikeSource)wwwroot\**" LogicalName="spar/app/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <RuntimeHostConfigurationOption Include="Spar.TestHost.IsSupported" Value="$(SparTestHostSupported)" Trim="true" />
  </ItemGroup>

  <Import Project="..\WebView2Loader.targets" />
</Project>
