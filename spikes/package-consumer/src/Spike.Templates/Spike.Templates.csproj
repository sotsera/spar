<Project Sdk="Microsoft.NET.Sdk">
  <!-- A dotnet new template package. It has no code of its own. -->
  <PropertyGroup>
    <PackageId>Spike.Templates</PackageId>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <!-- template.json is packed from obj/, with the package version filled in. -->
  <ItemGroup>
    <Content Include="content\**" Exclude="content\**\bin\**;content\**\obj\**;content\spar-app\.template.config\template.json"
             Pack="true" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="_SparWriteTemplateJson" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_SparTemplateJson>$(IntermediateOutputPath)template.json</_SparTemplateJson>
      <_SparTemplateText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/content/spar-app/.template.config/template.json'))</_SparTemplateText>
      <_SparTemplateText>$(_SparTemplateText.Replace('__PACKAGE_VERSION__', '$(Version)').TrimEnd())</_SparTemplateText>
    </PropertyGroup>

    <WriteLinesToFile File="$(_SparTemplateJson)" Lines="$(_SparTemplateText)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_SparTemplateJson)" />
      <None Include="$(_SparTemplateJson)" Pack="true" PackagePath="content\spar-app\.template.config\template.json" />
    </ItemGroup>
  </Target>
</Project>
