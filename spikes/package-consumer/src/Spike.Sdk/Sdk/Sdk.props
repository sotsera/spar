<Project>
  <!-- Written at pack time: SparSdkVersion, the version of this package. -->
  <Import Project="$(MSBuildThisFileDirectory)Spike.Sdk.Version.props" />

  <PropertyGroup>
    <_SparToolsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools'))</_SparToolsDirectory>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!-- App defaults. The project file can override each one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
  </PropertyGroup>

  <!-- The runtime library always matches the SDK version. Implicit, so central package management accepts it. -->
  <ItemGroup>
    <PackageReference Include="Spike.Runtime" Version="$(SparSdkVersion)" IsImplicitlyDefined="true" />
  </ItemGroup>
</Project>
