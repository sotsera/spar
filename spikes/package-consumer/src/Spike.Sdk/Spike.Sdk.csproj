<Project Sdk="Microsoft.NET.Sdk">
  <!-- The task assembly. MSBuild loads it from the package folder, so its dependencies sit beside it. -->
  <PropertyGroup>
    <AssemblyName>Spike.Tasks</AssemblyName>
    <RootNamespace>Spike.Tasks</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Packed as an MSBuild SDK: Sdk/ props and targets plus tools/ (tasks, generator, Roslyn). No lib/, no dependencies. -->
  <PropertyGroup>
    <PackageId>Spike.Sdk</PackageId>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SparPackTools</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="..\Spike.Generator\Spike.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Sdk\Sdk.props;Sdk\Sdk.targets" Pack="true" PackagePath="Sdk/" />
  </ItemGroup>

  <!--
    tools/ holds the task assembly and everything it loads, including Spike.Generator.dll.
    Sdk.targets passes that same file to the compiler as an analyzer, so the generator ships once.
  -->
  <Target Name="_SparPackTools" DependsOnTargets="_SparWriteVersionProps">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutDir)*.dll;$(OutDir)$(AssemblyName).deps.json" PackagePath="tools/" />
      <TfmSpecificPackageFile Include="$(_SparVersionProps)" PackagePath="Sdk/" />
    </ItemGroup>
  </Target>

  <!-- Sdk.props reads the package version from here to add the matching Spike.Runtime reference. -->
  <Target Name="_SparWriteVersionProps">
    <PropertyGroup>
      <_SparVersionProps>$(IntermediateOutputPath)Spike.Sdk.Version.props</_SparVersionProps>
    </PropertyGroup>

    <ItemGroup>
      <_SparVersionLine Include="&lt;Project&gt;" />
      <_SparVersionLine Include="  &lt;PropertyGroup&gt;" />
      <_SparVersionLine Include="    &lt;SparSdkVersion&gt;$(Version)&lt;/SparSdkVersion&gt;" />
      <_SparVersionLine Include="  &lt;/PropertyGroup&gt;" />
      <_SparVersionLine Include="&lt;/Project&gt;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_SparVersionProps)" Lines="@(_SparVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_SparVersionProps)" />
    </ItemGroup>
  </Target>
</Project>
