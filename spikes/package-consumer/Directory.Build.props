<Project>
  <!-- Inherit the repository policy (warnings as errors, code style), then add spike settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- One version for every package in the set. Pass -p:Version=0.1.1 to publish an update. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Spar spike</Authors>
    <Description>Package-consumer spike. Not for use.</Description>
  </PropertyGroup>

  <!-- The local feed is a collected output for transfer to the isolated consumer, so it lives in the root artifacts/. -->
  <PropertyGroup>
    <_SpikeRepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)..', 'global.json'))</_SpikeRepoRoot>
    <PackageOutputPath>$(_SpikeRepoRoot)/artifacts/package-consumer/feed/</PackageOutputPath>
  </PropertyGroup>
</Project>
