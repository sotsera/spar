<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Startup.Win is built in two manifest variants (-p:StartupManifest=full|none). Each variant keeps its own bin/ and
    obj/ subfolders, so both executables exist side by side.
  -->
  <PropertyGroup Condition="'$(StartupManifest)' == 'none'">
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/nomanifest/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/nomanifest/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
