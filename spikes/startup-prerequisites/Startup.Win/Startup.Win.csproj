<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Startup prerequisites spike, Windows: checks the OS, the WebView2 Runtime (presence, minimum version, environment
    and controller creation) and reports a failure on stderr, in a native dialog (task dialog or message box) and
    optionally in the event log, with a defined exit code. -p:StartupManifest=none builds it without an application
    manifest, to see what a NativeAOT exe without one gets.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Startup.Win</RootNamespace>
    <AssemblyName>Startup.Win</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <StartupManifest Condition="'$(StartupManifest)' == ''">full</StartupManifest>
    <ApplicationManifest Condition="'$(StartupManifest)' == 'full'">app.manifest</ApplicationManifest>
    <NoWin32Manifest Condition="'$(StartupManifest)' == 'none'">true</NoWin32Manifest>
    <DefineConstants Condition="'$(StartupManifest)' == 'none'">$(DefineConstants);NO_MANIFEST</DefineConstants>
  </PropertyGroup>

  <!-- NativeAOT links the WebView2 loader statically (one exe). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <DirectPInvoke Include="WebView2Loader" />
    <NativeLibrary Include="$(PkgMicrosoft_Web_WebView2)\build\native\x64\WebView2LoaderStatic.lib" />
  </ItemGroup>
</Project>
