<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Guest-side driver for the Windows cases (Windows Sandbox only): starts Startup.Win, times launch to the first window
    and to the dialog, captures the screen and the dialog, dumps the dialog's UI Automation tree with the native UIA
    client, dismisses it through UIA Invoke, and records the exit code and stderr. Also switches the guest's colour mode.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Startup.Probe</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
