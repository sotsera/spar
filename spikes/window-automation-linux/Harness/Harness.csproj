<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Linux window-test harness: a GTK4 window with a WebKitGTK 6.0 view per test, the page on spar://app, and Spar's
    own window-test API (the Windows spike's Option B shape) over a page-script engine plus XTEST input.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.WindowAutomation.Linux</RootNamespace>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page-script engine, shared with the Windows copy under windows/. -->
    <EmbeddedResource Include="../engine/engine.js" LogicalName="engine.js" />
  </ItemGroup>
</Project>
