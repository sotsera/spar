<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A copy of spikes/window-automation's Option B with one change: role queries can run through the shared page-script
    engine (../engine/engine.js) instead of Accessibility.queryAXTree. The host side (Shared/) is compiled from the
    Windows spike unchanged, by reference; nothing in that spike is edited.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Spar.WindowAutomation</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../window-automation/Shared/**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../engine/engine.js" LogicalName="engine.js" />
  </ItemGroup>

  <Import Project="../../window-automation/Shared/Desktop.targets" />
</Project>
