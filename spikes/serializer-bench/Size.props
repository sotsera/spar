<Project>
  <!-- Minimal NativeAOT apps for the executable-size comparison. Same settings as the D1 spike app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Bench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Note.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
