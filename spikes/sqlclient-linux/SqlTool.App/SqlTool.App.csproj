<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux copy of spikes/sqlclient-tool/SqlTool.App. SqlToolRuntime (see ../Directory.Build.props):
      aot  NativeAOT, linux-x64. Publish with the app-level warning acceptance:
           -p:TreatWarningsAsErrors=false -p:IlcTreatWarningsAsErrors=false
      jit  CoreCLR, framework-dependent (PublishAot=false, so no AOT feature switches either).
    There is no managed-SNI variant: on Linux SqlClient only has its managed networking.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- SqlConnection.Open throws NotSupportedException in invariant mode (checked again on Linux). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- [LibraryImport] stubs for the libsecret probe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SqlToolRuntime)' != 'jit'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SqlToolRuntime)' == 'jit'">
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

</Project>
