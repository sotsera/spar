<Project>
  <!-- Inherit the repository policy (warnings as errors, code style), then add spike settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <!-- Spike knob: -p:SqlToolRuntime=aot (default, NativeAOT) | jit (CoreCLR, framework-dependent).
         Each runtime gets its own bin/ and obj/ so restores and outputs do not overwrite each other. -->
    <SqlToolRuntime Condition="'$(SqlToolRuntime)' == ''">aot</SqlToolRuntime>
    <BaseOutputPath>bin/$(SqlToolRuntime)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/$(SqlToolRuntime)/</BaseIntermediateOutputPath>
    <!-- The other runtimes' outputs sit in sibling folders; keep their generated sources out of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
