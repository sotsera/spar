<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CsWinRT 3.0 reference projection of Microsoft.Web.WebView2.Core.winmd (the documented 3.0 shape: a projection is its
    own library; the implementation is regenerated into WinRT.Projection.dll when the app is built).
  -->
  <PropertyGroup>
    <TargetFramework>$(SpikeWindowsTfm)</TargetFramework>
    <CsWinRTGenerateReferenceProjection>true</CsWinRTGenerateReferenceProjection>
    <CsWinRTIncludes>Microsoft.Web.WebView2.Core</CsWinRTIncludes>
    <!-- A library is not published on its own; the app's settings apply. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <CsWinRTInputs Include="$(PkgMicrosoft_Web_WebView2)\lib\Microsoft.Web.WebView2.Core.winmd" />
  </ItemGroup>
</Project>
