<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows SDK projection through CsWinRT 3.0 in an unpackaged NativeAOT exe.
    -p:SpikeApi=Baseline|Vault|Picker|Toast compiles one API probe, so each publication measures one API's size.
    -p:SpikeNoWinRT=true builds the baseline as plain net11.0-windows with no CsWinRT at all.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <SpikeApi Condition="'$(SpikeApi)' == ''">All</SpikeApi>
    <TargetFramework Condition="'$(SpikeNoWinRT)' != 'true'">$(SpikeWindowsTfm)</TargetFramework>
    <TargetFramework Condition="'$(SpikeNoWinRT)' == 'true'">net11.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);SPIKE_$(SpikeApi.ToUpperInvariant())</DefineConstants>
    <DefineConstants Condition="'$(SpikeNoWinRT)' == 'true'">$(DefineConstants);SPIKE_NO_WINRT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- Supplies WinRT.Runtime 3.0 and the cswinrtgen tools; the SDK projection package has neither for CsWinRT 3.0. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Condition="'$(SpikeNoWinRT)' != 'true'" />
  </ItemGroup>
</Project>
