<Project>
  <!-- Repository versions first (xunit.v3, Microsoft.Playwright), then the spike's additions. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <!-- xUnit's Native AOT flavour: a separate package family, needed for the AOT comparison only. -->
    <PackageVersion Include="xunit.v3.aot" Version="4.0.3" />
  </ItemGroup>
</Project>
