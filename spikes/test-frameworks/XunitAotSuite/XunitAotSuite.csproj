<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same test sources as XunitSuite, built against xunit.v3.aot (source-generated registration). -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);XUNIT_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
    <Using Include="Xunit" />
    <Compile Include="..\XunitSuite\**\*.cs" Exclude="..\XunitSuite\obj\**;..\XunitSuite\bin\**" LinkBase="Tests" />
  </ItemGroup>
</Project>
