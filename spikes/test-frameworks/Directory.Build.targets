<Project>
  <!-- Records the app path relative to the test output folder (the loopback spike's own targets file). -->
  <Import Project="..\loopback\Loop.Tests\AppPathMetadata.targets" Condition="'$(SpikeBrowser)' == 'true'" />

  <!-- -p:SpikeScale=true adds 2,000 more facts (Scale folders); left out otherwise. -->
  <PropertyGroup Condition="'$(SpikeScale)' == 'true'">
    <DefineConstants>$(DefineConstants);SPIKE_SCALE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SpikeScale)' != 'true'">
    <Compile Remove="Scale\**;..\XunitSuite\Scale\**" />
  </ItemGroup>
</Project>
