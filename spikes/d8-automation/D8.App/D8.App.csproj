<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike knobs (pass with -p:):
      SparDevtools   = Enabled (default) | Switched (code compiled, feature switch off) | Excluded (#if removes it)
      WebView2Loader = Static (default, WebView2LoaderStatic.lib linked into the AOT exe) | Dll (sidecar)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SparDevtools Condition="'$(SparDevtools)' == ''">Enabled</SparDevtools>
    <WebView2Loader Condition="'$(WebView2Loader)' == ''">Static</WebView2Loader>
    <DefineConstants Condition="'$(SparDevtools)' != 'Excluded'">$(DefineConstants);SPAR_DEVTOOLS</DefineConstants>
    <DefineConstants Condition="'$(SparDevtoolsServer)' != 'false'">$(DefineConstants);SPAR_DEVTOOLS_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- Only the native loader is used; the managed WebView2 assemblies are not referenced. -->
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(SparDevtools)' != 'Excluded'">
    <RuntimeHostConfigurationOption Include="Spar.Devtools.IsSupported"
                                    Value="$([System.String]::Equals('$(SparDevtools)', 'Enabled'))"
                                    Trim="true" />
  </ItemGroup>

  <PropertyGroup>
    <_WebView2NativeDir>$(PkgMicrosoft_Web_WebView2)\build\native\x64\</_WebView2NativeDir>
  </PropertyGroup>

  <!-- JIT runs (dotnet build/run) always need the sidecar loader. -->
  <ItemGroup>
    <None Include="$(_WebView2NativeDir)WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebView2Loader)' == 'Static'">
    <DirectPInvoke Include="WebView2Loader" />
    <NativeLibrary Include="$(_WebView2NativeDir)WebView2LoaderStatic.lib" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebView2Loader)' == 'Dll'">
    <None Update="$(_WebView2NativeDir)WebView2Loader.dll" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
