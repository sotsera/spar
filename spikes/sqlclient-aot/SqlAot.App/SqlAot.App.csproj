<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike knobs (pass with -p:):
      SqlProvider            = Microsoft (default, Microsoft.Data.SqlClient) | System (deprecated System.Data.SqlClient)
      SqlClientVersion       = Microsoft.Data.SqlClient version (default in ../Directory.Packages.props)
      InvariantGlobalization = false (default: SqlConnection.Open throws NotSupportedException in invariant mode) | true
      SqlManagedSni          = false (default, native SNI sidecar DLL) | true (managed networking, no native DLL)
      TrimmerSingleWarn      = false (default here: one warning per member) | true (SDK default: one per assembly)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn Condition="'$(TrimmerSingleWarn)' == ''">false</TrimmerSingleWarn>
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">false</InvariantGlobalization>
    <SqlProvider Condition="'$(SqlProvider)' == ''">Microsoft</SqlProvider>
    <DefineConstants Condition="'$(SqlProvider)' == 'System'">$(DefineConstants);SYSTEM_SQLCLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(SqlProvider)' == 'Microsoft'">
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup Condition="'$(SqlProvider)' == 'System'">
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>

  <!-- SqlManagedSni=true: managed TDS networking on Windows; the native SNI DLL is not deployed. -->
  <ItemGroup Condition="'$(SqlManagedSni)' == 'true'">
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.UseManagedNetworkingOnWindows"
                                    Value="true"
                                    Trim="true" />
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

</Project>
