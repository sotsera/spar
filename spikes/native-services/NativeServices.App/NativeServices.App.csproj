<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike knob (pass with -p:): SpikeParts = semicolon list of the pieces compiled in, for size deltas.
      Dialogs        file dialogs through hand-declared [GeneratedComInterface] COM
      ComBaseline    one [GeneratedComInterface] call (IShellItem), standing in for the COM a WebView2 host already has
      CsWin32Dialogs file dialogs through CsWin32's allowMarshaling=false COM structs
      Grants         backend-owned grant table (needs Dialogs for the end-to-end check)
      CredMan        Credential Manager through [LibraryImport]
      Dpapi          CryptProtectData through [LibraryImport]
      ProtectedData  System.Security.Cryptography.ProtectedData package
    Default: all of them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SpikeParts Condition="'$(SpikeParts)' == ''">Dialogs;CsWin32Dialogs;Grants;CredMan;Dpapi;ProtectedData</SpikeParts>
    <SpikePartsPadded>;$(SpikeParts);</SpikePartsPadded>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';Dialogs;'))">$(DefineConstants);PART_DIALOGS</DefineConstants>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';ComBaseline;'))">$(DefineConstants);PART_COMBASELINE</DefineConstants>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';CsWin32Dialogs;'))">$(DefineConstants);PART_CSWIN32_DIALOGS</DefineConstants>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';Grants;'))">$(DefineConstants);PART_GRANTS</DefineConstants>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';CredMan;'))">$(DefineConstants);PART_CREDMAN</DefineConstants>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';Dpapi;'))">$(DefineConstants);PART_DPAPI</DefineConstants>
    <DefineConstants Condition="$(SpikePartsPadded.Contains(';ProtectedData;'))">$(DefineConstants);PART_PROTECTEDDATA</DefineConstants>
    <!-- Repro of the IFileSaveDialog cast failure: SpikeSaveRepro = Derived (fails) or Rooted (works). -->
    <DefineConstants Condition="'$(SpikeSaveRepro)' != ''">$(DefineConstants);SPIKE_SAVE_AS_DERIVED</DefineConstants>
    <DefineConstants Condition="'$(SpikeSaveRepro)' == 'Rooted'">$(DefineConstants);SPIKE_SAVE_METHOD_ROOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- Always referenced so every size variant restores the same graph; unused code is trimmed. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
