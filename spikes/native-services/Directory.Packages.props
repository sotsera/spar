<Project>
  <!-- Repository versions first, then the spike's Windows-only packages (versions already in the local NuGet cache). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.369" />
    <!-- 11.0.0 is not cached; 10.0.13 (net8.0+ lib) is. Compared against direct CryptProtectData imports. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
</Project>
