<Project>
  <!-- Aspire.Hosting.AppHost is referenced implicitly by Aspire.AppHost.Sdk (NU1009 if listed here).
       Repository versions first, then Aspire and the data client (spike-local; Aspire 13.6.5, the latest). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>
</Project>
