<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal WebView2 host (pieces copied from spikes/asset-packing) for the desktop-origin checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.DesktopOrigin</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="www/**" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
</Project>
