<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles one probe case against one Result form, for example -p:Form=UnionStruct -p:Case=Conversions -->
  <PropertyGroup>
    <Form Condition="'$(Form)' == ''">UnionStruct</Form>
    <Case Condition="'$(Case)' == ''">Conversions</Case>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Each form and case gets its own intermediate folder, so the runs do not invalidate each other. -->
    <ProbeFolder>$(Form)\$(Case)</ProbeFolder>
    <ProbeFolder Condition="'$(UseAnalyzer)' == 'true'">$(ProbeFolder)-analyzer</ProbeFolder>
    <IntermediateOutputPath>obj\$(Configuration)\$(ProbeFolder)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(ProbeFolder)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Forms\$(Form)\Result.cs" LinkBase="Form" />
    <Compile Include="..\Shared\Domain.cs" LinkBase="Shared" />
    <Compile Include="Cases\$(Case).cs" />
  </ItemGroup>

  <!-- -p:UseAnalyzer=true adds the default(Result) analyzer prototype. -->
  <ItemGroup Condition="'$(UseAnalyzer)' == 'true'">
    <ProjectReference Include="..\Analyzers\Spar.ResultAnalyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
