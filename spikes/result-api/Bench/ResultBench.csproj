<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- BenchmarkDotNet requires optimized code. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- The form projects live below this folder; their sources come in through the references. -->
    <Compile Remove="Forms\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="Forms\Class\Spar.Result.Class.csproj" Aliases="FormClass" />
    <ProjectReference Include="Forms\Struct\Spar.Result.Struct.csproj" Aliases="FormStruct" />
    <ProjectReference Include="Forms\UnionStruct\Spar.Result.UnionStruct.csproj" Aliases="FormUnionStruct" />
    <ProjectReference Include="Forms\UnionClass\Spar.Result.UnionClass.csproj" Aliases="FormUnionClass" />
  </ItemGroup>
</Project>
