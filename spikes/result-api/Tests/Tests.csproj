<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same tests against one Result form: dotnet test (project Tests/Tests.csproj) with -p:Form=UnionStruct -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Form Condition="'$(Form)' == ''">UnionStruct</Form>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IntermediateOutputPath>obj\$(Configuration)\$(Form)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(Form)\</OutputPath>
    <DefineConstants Condition="'$(Form)' == 'Struct' or '$(Form)' == 'UnionStruct'">$(DefineConstants);RESULT_STRUCT</DefineConstants>
    <DefineConstants Condition="'$(Form)' == 'UnionStruct' or '$(Form)' == 'UnionClass'">$(DefineConstants);RESULT_UNION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Forms\$(Form)\Result.cs" LinkBase="Form" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Compile Include="Common\*.cs" />
    <Compile Include="Union\*.cs" Condition="$(DefineConstants.Contains('RESULT_UNION'))" />
  </ItemGroup>
</Project>
