     public async Task Saves_a_note_through_the_real_backend(string browserKind)
     {
+        if (browserKind == "msedge-headless" && !OperatingSystem.IsWindows())
+        {
+            Assert.Skip("Microsoft Edge is not installed in the Linux image.");
