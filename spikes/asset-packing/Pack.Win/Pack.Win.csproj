<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal WebView2 host (pieces copied from the React spike) serving the embedded frontend from the pack. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.AssetPacking</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
  <Import Project="../Pack.targets" />
</Project>
