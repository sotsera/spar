<Project>
  <!--
    Imported by the spike apps. Packs the selected input bundle in the selected format, embeds the result, compiles the
    matching reader (Pack.Runtime, selected by SPAR_PACK_<FORMAT>), and nothing else:
      PackFrontendAssets  runs the PackFrontend task when the input set, an input file or the task changes;
                          outputs are written only when their bytes change, and a stamp records that packing ran
      EmbedFrontendAssets always: adds the packed files as EmbeddedResource items
    PackFormat=none embeds nothing and compiles no reader (the size baseline).
  -->
  <PropertyGroup>
    <PackWindow Condition="'$(PackWindow)' == ''">0</PackWindow>
    <PackInputDirectory Condition="'$(PackInput)' == 'react'">$(MSBuildThisFileDirectory)inputs/react/</PackInputDirectory>
    <PackInputDirectory Condition="'$(PackInput)' == 'large'">$(MSBuildThisFileDirectory)obj/inputs/large/</PackInputDirectory>
    <DefineConstants>$(DefineConstants);SPAR_PACK_$(PackFormat.ToUpperInvariant())</DefineConstants>
    <!--
      PackFormat=auto: the reader is the Brotli one (one resource), and the decoder is removed by a trimming feature
      switch when PackCompress=false (then everything is packed as stored).
    -->
    <DefineConstants Condition="'$(PackFormat)' == 'auto'">$(DefineConstants);SPAR_PACK_BROTLI</DefineConstants>
    <_PackTaskFormat>$(PackFormat)</_PackTaskFormat>
    <_PackTaskFormat Condition="'$(PackFormat)' == 'auto' and '$(PackCompress)' == 'false'">raw</_PackTaskFormat>
    <_PackTaskFormat Condition="'$(PackFormat)' == 'auto' and '$(PackCompress)' != 'false'">brotli</_PackTaskFormat>
    <!-- The Content-Encoding probe (Pack.Runtime/EncodingProbe.cs) exists only in probe builds. -->
    <DefineConstants Condition="'$(PackProbe)' == 'true'">$(DefineConstants);SPAR_ENCODING_PROBE</DefineConstants>
    <_PackDir>$(BaseIntermediateOutputPath)spar-pack/</_PackDir>
    <_PackTasksPath>$(MSBuildThisFileDirectory)Pack.Tasks/bin/$(Configuration)/net11.0/Pack.Tasks.dll</_PackTasksPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackFormat)' == 'auto'">
    <RuntimeHostConfigurationOption Include="Spar.Frontend.Brotli" Value="$([MSBuild]::ValueOrDefault('$(PackCompress)', 'true'))" Trim="true" />
  </ItemGroup>

  <UsingTask TaskName="Spar.AssetPacking.PackFrontend" AssemblyFile="$(_PackTasksPath)" TaskFactory="TaskHostFactory" Runtime="NET" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Pack.Tasks/Pack.Tasks.csproj"
                      ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PackFormat;PackInput;PackWindow;PackProbe;PackCompress" />
    <Compile Include="$(MSBuildThisFileDirectory)Pack.Runtime/*.cs" Link="Pack.Runtime/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackFormat)' != 'none'">
    <_PackInput Include="$(PackInputDirectory)**/*" />
  </ItemGroup>

  <!-- The input list is an input too, so a removed file repacks (timestamps alone cannot show a removal). -->
  <Target Name="PackFrontendInventory" Condition="'$(PackFormat)' != 'none' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'@(_PackInput)' == ''" Text="No frontend files in '$(PackInputDirectory)'. For PackInput=large run scripts/make-large.sh first." />
    <MakeDir Directories="$(_PackDir)" />
    <WriteLinesToFile File="$(_PackDir)inputs.txt" Lines="format=$(_PackTaskFormat);window=$(PackWindow);@(_PackInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="PackFrontendAssets" DependsOnTargets="ResolveProjectReferences;PackFrontendInventory" BeforeTargets="AssignTargetPaths"
          Condition="'$(PackFormat)' != 'none' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(_PackInput);$(_PackDir)inputs.txt;$(_PackTasksPath)" Outputs="$(_PackDir)pack.stamp">
    <PackFrontend InputDirectory="$(PackInputDirectory)" OutputDirectory="$(_PackDir)out" Format="$(_PackTaskFormat)" Window="$(PackWindow)" />
    <Touch Files="$(_PackDir)pack.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedFrontendAssets" AfterTargets="PackFrontendAssets" BeforeTargets="AssignTargetPaths"
          Condition="'$(PackFormat)' != 'none' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PackResource Include="$(_PackDir)out/frontend.pack" LogicalName="Spar.Frontend" Condition="'$(PackFormat)' == 'raw' or '$(PackFormat)' == 'brotli' or '$(PackFormat)' == 'auto'" />
      <_PackResource Include="$(_PackDir)out/frontend.zip" LogicalName="Spar.Frontend" Condition="'$(PackFormat)' == 'zip'" />
      <_PackResource Include="$(_PackDir)out/index.bin" LogicalName="Spar.Frontend.index" Condition="'$(PackFormat)' == 'separate'" />
      <_PackEntryFile Include="$(_PackDir)out/????.bin" Condition="'$(PackFormat)' == 'separate'" />
      <_PackResource Include="@(_PackEntryFile)" LogicalName="Spar.Frontend.%(Filename)" />
      <EmbeddedResource Include="@(_PackResource)" Type="Non-Resx" WithCulture="false" />
    </ItemGroup>
  </Target>
</Project>
