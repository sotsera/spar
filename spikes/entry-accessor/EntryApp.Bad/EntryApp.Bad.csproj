<Project Sdk="Microsoft.NET.Sdk">
  <!-- Program.cs shapes the test host cannot run: -p:Shape=void|classic|async. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Shape Condition="'$(Shape)' == ''">void</Shape>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="shapes\$(Shape).cs" />
    <ProjectReference Include="..\Spar.Entry\Spar.Entry.csproj" />
    <ProjectReference Include="..\EntryGen\EntryGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="SparVariant" />
  </ItemGroup>
</Project>
