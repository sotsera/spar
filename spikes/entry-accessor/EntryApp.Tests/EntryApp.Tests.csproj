<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's test project: it builds the app as SparVariant=Test and writes StartAsync<Program>(). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EntryApp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\EntryApp\EntryApp.csproj" AdditionalProperties="SparVariant=Test" />
    <ProjectReference Include="..\Spar.Entry\Spar.Entry.csproj" />
    <ProjectReference Include="..\..\test-host\Spar.Mini.Testing\Spar.Mini.Testing.csproj" />
    <Compile Include="..\..\test-host\SampleApp.Tests\NotesClient.cs" Link="NotesClient.cs" />
    <RuntimeHostConfigurationOption Include="Spar.TestHost.IsSupported" Value="true" Trim="true" />
  </ItemGroup>
</Project>
