<Project>
  <!-- Inherit the repository policy (warnings as errors, code style), then add spike settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The decided mapping (decision "Polished sample apps: a Markdown notebook; the test variant"): Debug builds
    Development, Release builds Production, and a test project builds its referenced app as Test. An explicit
    SparVariant wins. The Test build of the app gets its own intermediate and output folders, so it never overwrites
    the app's own Debug build (restore output stays shared in obj/).
  -->
  <PropertyGroup>
    <!-- Configuration is not defaulted yet when this file is read. -->
    <_SparConfiguration>$(Configuration)</_SparConfiguration>
    <_SparConfiguration Condition="'$(_SparConfiguration)' == ''">Debug</_SparConfiguration>
    <SparVariant Condition="'$(SparVariant)' == '' and '$(_SparConfiguration)' == 'Release'">Production</SparVariant>
    <SparVariant Condition="'$(SparVariant)' == ''">Development</SparVariant>
    <IntermediateOutputPath Condition="'$(SparVariant)' == 'Test'">obj\test\$(_SparConfiguration)\</IntermediateOutputPath>
    <OutputPath Condition="'$(SparVariant)' == 'Test'">bin\test\$(_SparConfiguration)\</OutputPath>
  </PropertyGroup>
</Project>
