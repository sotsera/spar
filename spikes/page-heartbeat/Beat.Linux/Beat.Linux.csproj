<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Page-heartbeat spike, Linux host: GTK 4 + WebKitGTK 6.0 only, NativeAOT. Native imports and the GLib context are
    copied from spikes/resource-usage. The pages (../www) are read from disk.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.PageHeartbeat</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
