<Project>
  <!--
    The frontend lives in its own .esproj (Microsoft.VisualStudio.JavaScript.Sdk). Two ways to consume it:

      Drive (default)  After SparGenerateClient, the app builds the .esproj with the MSBuild task and packs the folder it
                       returns. The generated @spar packages therefore exist before npm and Vite run. The solution does
                       not build the .esproj on its own (see Esproj.slnx).
      Reference        A ProjectReference (ReferenceOutputAssembly=false). MSBuild builds the .esproj during
                       ResolveProjectReferences, which is before the app has generated its client.

    Debug (SparDevServerBuild=true) builds no bundle and embeds a placeholder page.
  -->
  <PropertyGroup>
    <SparFrontendProject>$(SparFrontendPath)Esproj.Frontend.esproj</SparFrontendProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(SpikeFrontendMode)' == 'Reference' or '$(SpikeFrontendMode)' == 'Cycle'">
    <ProjectReference Include="$(SparFrontendProject)" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
  </ItemGroup>

  <Target Name="SparBuildFrontendProject" AfterTargets="SparGenerateClient" BeforeTargets="SparPackFrontend"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SparDevServerBuild)' != 'true'">
    <MSBuild Condition="'$(SpikeFrontendMode)' == 'Drive'" Projects="$(SparFrontendProject)" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;Platform;TargetFramework">
      <Output TaskParameter="TargetOutputs" PropertyName="_SparFrontendOut" />
    </MSBuild>

    <!-- Reference: the .esproj has been built already; ask it where its output is. -->
    <MSBuild Condition="'$(SpikeFrontendMode)' == 'Reference' or '$(SpikeFrontendMode)' == 'Cycle'" Projects="$(SparFrontendProject)" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;Platform;TargetFramework">
      <Output TaskParameter="TargetOutputs" PropertyName="_SparFrontendOut" />
    </MSBuild>

    <PropertyGroup>
      <SparPackDirectories>$(_SparFrontendOut)</SparPackDirectories>
    </PropertyGroup>
    <ItemGroup>
      <SparPackInput Include="$(_SparFrontendOut)**/*" />
    </ItemGroup>
    <Message Importance="high" Text="SPIKE: frontend output $(_SparFrontendOut)" />
  </Target>

  <Target Name="SparDevPlaceholder" AfterTargets="SparGenerateClient" BeforeTargets="SparPackFrontend"
          Condition="'$(SparDevServerBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SparDevPlaceholder>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'spar', 'dev-placeholder'))</_SparDevPlaceholder>
      <SparPackDirectories>$(_SparDevPlaceholder)</SparPackDirectories>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SparDevPlaceholder)index.html" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;!doctype html&gt;&lt;title&gt;Development build&lt;/title&gt;&lt;p&gt;Open the dev server.&lt;/p&gt;" />
    <ItemGroup>
      <SparPackInput Include="$(_SparDevPlaceholder)index.html" />
    </ItemGroup>
  </Target>

  <!-- Debug: no bundle, but the dev server needs node_modules. Run only the SDK's own npm install step. -->
  <Target Name="SparDevNpmInstall" AfterTargets="SparGenerateClient" BeforeTargets="SparPackFrontend"
          Condition="'$(SparDevServerBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SpikeFrontendMode)' == 'Drive'">
    <MSBuild Projects="$(SparFrontendProject)" Targets="RunNpmInstall" Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;Platform;TargetFramework" />
  </Target>
</Project>
