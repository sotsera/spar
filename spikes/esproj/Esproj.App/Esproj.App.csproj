<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Esproj.App</RootNamespace>
    <!-- The build machine's own runtime, so the apphost runs where it was built. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Tasks are built in this same graph (source checkout): short-lived task host, no locked DLLs. -->
    <SpikeTaskMode>TaskHost</SpikeTaskMode>

    <!-- The frontend is its own .esproj, a sibling folder. -->
    <SparFrontendPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'Esproj.Frontend'))</SparFrontendPath>

    <!--
      Drive (default): the app builds the .esproj after generating the client. Reference: a ProjectReference to the
      .esproj. Targets: the baseline, a copy of React.targets that runs npm and Vite itself (no .esproj involved).
    -->
    <SpikeFrontendMode Condition="'$(SpikeFrontendMode)' == ''">Drive</SpikeFrontendMode>

    <!-- Baseline only: package.json lists the generated packages as file: dependencies; no junction. -->
    <SparLinkPackages>false</SparLinkPackages>
  </PropertyGroup>

  <!-- Debug embeds no production bundle (the dev server serves the page); Release embeds it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SparDevServerBuild Condition="'$(SparDevServerBuild)' == ''">true</SparDevServerBuild>
  </PropertyGroup>

  <Import Project="..\pipeline\Spike.targets" />
  <Import Project="Esproj.targets" Condition="'$(SpikeFrontendMode)' != 'Targets'" />
  <Import Project="React.targets" Condition="'$(SpikeFrontendMode)' == 'Targets'" />
</Project>
