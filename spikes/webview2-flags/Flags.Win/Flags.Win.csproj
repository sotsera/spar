<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WebView2 flags spike (M1b step 9): browser arguments through the environment options, the SmartScreen flag against a
    net log, the noexpose_wasm V8 flag, and the find API. One executable: `drive <plan.json>` makes a desktop of its own,
    starts a loopback listener and runs each job as a child process on that desktop (`host <job.json>`). CoreCLR with
    WebView2's managed API: the spike measures the Runtime, not Spar's declarations. Throwaway.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>WebView2Flags</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="www/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Only the Core API is used; the package also references its UI-library wrappers, which conflict on WindowsBase. -->
  <Target Name="DropWebView2UiWrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
</Project>
