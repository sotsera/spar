<Project>
  <!-- Inherit the repository policy (warnings as errors, code style), then add the spike's settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!--
    Spike knob: -p:ConfigCostVariant=0 (baseline) | 1 (JSON file for logging) | 2 (1 + environment variables, IConfiguration
    in DI, an options class bound by the binding generator) | 3 (2 with reloadOnChange). Each variant restores different
    packages, so each gets its own bin/ and obj/; the generated client stays in obj/spar/client for all of them.
  -->
  <PropertyGroup>
    <ConfigCostVariant Condition="'$(ConfigCostVariant)' == ''">0</ConfigCostVariant>
    <BaseIntermediateOutputPath>obj\v$(ConfigCostVariant)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\v$(ConfigCostVariant)\</BaseOutputPath>
  </PropertyGroup>
</Project>
