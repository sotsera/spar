<Project>
  <!--
    Candidate A pipeline:
      ResolveReferences
        -> SparWriteContractInventory   (sources/references/defines, written only when changed)
        -> SparGenerateClient           (out-of-process tool: contracts.json + TypeScript, incremental)
        -> SparPackFrontend             (deterministic zip of authored frontend + generated client)
        -> EmbeddedResource "Spar.Frontend"
      CoreCompile (one compilation; the source generator emits all C#)
  -->
  <PropertyGroup>
    <SpikeSerializer Condition="'$(SpikeSerializer)' == ''">Spar</SpikeSerializer>
    <SparFrontendPath Condition="'$(SparFrontendPath)' == ''">$(MSBuildProjectDirectory)/frontend/</SparFrontendPath>
    <_SparToolPath>$(MSBuildThisFileDirectory)Spike.Tool/bin/$(Configuration)/net11.0/Spike.Tool.dll</_SparToolPath>

    <!-- Exec: separate dotnet process per run. InProc: task in the MSBuild node. TaskHost: short-lived task host. -->
    <SpikeTaskMode Condition="'$(SpikeTaskMode)' == ''">Exec</SpikeTaskMode>
    <_SparTasksPath>$(MSBuildThisFileDirectory)Spike.Tasks/bin/$(Configuration)/net11.0/Spike.Tasks.dll</_SparTasksPath>
  </PropertyGroup>

  <UsingTask TaskName="Spike.Tasks.GenerateContractClient" AssemblyFile="$(_SparTasksPath)"
             Condition="'$(SpikeTaskMode)' == 'InProc'" />
  <UsingTask TaskName="Spike.Tasks.PackFrontend" AssemblyFile="$(_SparTasksPath)"
             Condition="'$(SpikeTaskMode)' == 'InProc'" />
  <UsingTask TaskName="Spike.Tasks.GenerateContractClient" AssemblyFile="$(_SparTasksPath)"
             Runtime="NET" Condition="'$(SpikeTaskMode)' == 'Net'" />
  <UsingTask TaskName="Spike.Tasks.PackFrontend" AssemblyFile="$(_SparTasksPath)"
             Runtime="NET" Condition="'$(SpikeTaskMode)' == 'Net'" />
  <UsingTask TaskName="Spike.Tasks.GenerateContractClient" AssemblyFile="$(_SparTasksPath)"
             TaskFactory="TaskHostFactory" Runtime="NET" Condition="'$(SpikeTaskMode)' == 'TaskHost'" />
  <UsingTask TaskName="Spike.Tasks.PackFrontend" AssemblyFile="$(_SparTasksPath)"
             TaskFactory="TaskHostFactory" Runtime="NET" Condition="'$(SpikeTaskMode)' == 'TaskHost'" />

  <ItemGroup>
    <CompilerVisibleProperty Include="SpikeSerializer" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Spike.Generator/Spike.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Spike.Tool/Spike.Tool.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;SpikeSerializer"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Spike.Runtime/Spike.Runtime.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Spike.Tasks/Spike.Tasks.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;SpikeSerializer;SpikeTaskMode"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="SparWriteContractInventory" DependsOnTargets="ResolveReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SparDir>$(IntermediateOutputPath)spar/</_SparDir>
      <!-- The generated client is the same for every configuration: one location, so package.json can link it. -->
      <_SparClientDir>$(BaseIntermediateOutputPath)spar/client</_SparClientDir>
      <_SparInventory>$(_SparDir)contracts.inventory</_SparInventory>
    </PropertyGroup>
    <ItemGroup>
      <_SparInventoryLine Include="langversion=$(LangVersion)" />
      <_SparInventoryLine Include="nullable=$(Nullable)" />
      <_SparInventoryLine Include="define=$(DefineConstants)" />
      <_SparInventoryLine Include="@(Compile->'source=%(FullPath)')" />
      <_SparInventoryLine Include="@(ReferencePath->'reference=%(FullPath)')" />
    </ItemGroup>
    <MakeDir Directories="$(_SparDir)" />
    <WriteLinesToFile File="$(_SparInventory)" Lines="@(_SparInventoryLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="SparGenerateClient" DependsOnTargets="SparWriteContractInventory"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(_SparInventory);@(Compile);$(_SparToolPath);$(_SparTasksPath)" Outputs="$(_SparDir)client.stamp">
    <Exec Condition="'$(SpikeTaskMode)' == 'Exec'"
          Command="dotnet &quot;$(_SparToolPath)&quot; client &quot;$(_SparInventory)&quot; &quot;$(_SparClientDir)&quot;" />
    <GenerateContractClient Condition="'$(SpikeTaskMode)' != 'Exec'"
                            InventoryFile="$(_SparInventory)" OutputDirectory="$(_SparClientDir)" />
    <Touch Files="$(_SparDir)client.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="SparPackFrontend" DependsOnTargets="SparGenerateClient" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_SparFrontendInput);@(SparPackInput);$(_SparDir)client.stamp" Outputs="$(_SparDir)frontend.pack.stamp">
    <!-- A bundler frontend sets SparPackDirectories to its build output and adds SparPackInput items. -->
    <PropertyGroup>
      <_SparPackDirectories>$(SparPackDirectories)</_SparPackDirectories>
      <_SparPackDirectories Condition="'$(_SparPackDirectories)' == ''">$(SparFrontendPath);$(_SparClientDir)</_SparPackDirectories>
    </PropertyGroup>
    <Exec Condition="'$(SpikeTaskMode)' == 'Exec'"
          Command="dotnet &quot;$(_SparToolPath)&quot; pack &quot;$(_SparDir)frontend.zip&quot; &quot;$(SparFrontendPath).&quot; &quot;$(_SparClientDir)&quot;" />
    <PackFrontend Condition="'$(SpikeTaskMode)' != 'Exec'"
                  ZipFile="$(_SparDir)frontend.zip" Directories="$(_SparPackDirectories)" />
    <!-- The zip keeps its timestamp when its bytes are unchanged (so CoreCompile stays skipped); the stamp records that packing ran. -->
    <Touch Files="$(_SparDir)frontend.pack.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="SparEmbedFrontend" AfterTargets="SparPackFrontend" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <EmbeddedResource Include="$(_SparDir)frontend.zip" LogicalName="Spar.Frontend" Type="Non-Resx" WithCulture="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <_SparFrontendInput Include="$(SparFrontendPath)**/*"
                        Exclude="$(SparFrontendPath)node_modules/**;$(SparFrontendPath)dist/**" />
  </ItemGroup>

  <!--
    Contract snapshot (spike): <Project>.contracts.snapshot next to the project is committed.
      Update (default): copy the generated snapshot there when it differs, and say so.
      Verify (default when ContinuousIntegrationBuild=true): fail with SPAR100 when it differs or is missing.
      Off: do nothing.
  -->
  <PropertyGroup>
    <SparContractSnapshot Condition="'$(SparContractSnapshot)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">Verify</SparContractSnapshot>
    <SparContractSnapshot Condition="'$(SparContractSnapshot)' == ''">Update</SparContractSnapshot>
    <SparContractSnapshotFile Condition="'$(SparContractSnapshotFile)' == ''">$(MSBuildProjectDirectory)/$(MSBuildProjectName).contracts.snapshot</SparContractSnapshotFile>
  </PropertyGroup>

  <Target Name="SparContractSnapshot" AfterTargets="SparGenerateClient"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SparContractSnapshot)' != 'Off'">
    <GetFileHash Files="$(_SparClientDir)/contracts.snapshot">
      <Output TaskParameter="Hash" PropertyName="_SparSnapshotGenerated" />
    </GetFileHash>
    <GetFileHash Files="$(SparContractSnapshotFile)" Condition="Exists('$(SparContractSnapshotFile)')">
      <Output TaskParameter="Hash" PropertyName="_SparSnapshotCommitted" />
    </GetFileHash>
    <Error Condition="'$(SparContractSnapshot)' == 'Verify' and '$(_SparSnapshotGenerated)' != '$(_SparSnapshotCommitted)'"
           Code="SPAR100" File="$(SparContractSnapshotFile)"
           Text="The contracts or the generated client changed and this snapshot is out of date. Build locally to update it, review the diff and commit it." />
    <Copy Condition="'$(SparContractSnapshot)' == 'Update' and '$(_SparSnapshotGenerated)' != '$(_SparSnapshotCommitted)'"
          SourceFiles="$(_SparClientDir)/contracts.snapshot" DestinationFiles="$(SparContractSnapshotFile)" />
    <Message Condition="'$(SparContractSnapshot)' == 'Update' and '$(_SparSnapshotGenerated)' != '$(_SparSnapshotCommitted)'"
             Importance="high" Text="SPAR: contract snapshot updated: $(SparContractSnapshotFile). Review and commit it." />
  </Target>
</Project>
