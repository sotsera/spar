<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spike.App</RootNamespace>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IDE and plain builds use the MSBuild tasks. Pass -p:SpikeTaskMode=Exec for the original pipeline. -->
    <SpikeTaskMode Condition="'$(SpikeTaskMode)' == ''">Net</SpikeTaskMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(SpikeSerializer)' != 'Stj'">
    <Compile Remove="SpikeJsonContext.cs" />
  </ItemGroup>

  <Import Project="..\Spike.targets" />
</Project>
