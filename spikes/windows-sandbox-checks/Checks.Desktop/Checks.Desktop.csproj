<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows Sandbox checks: the custom title bar host of spikes/windows-titlebar (copied, then extended) at other DPI
    scales and with accessibility experiments, plus camera and microphone permission probes on WebView2. Real input,
    display scaling changes and media calls refuse to run outside the Windows Sandbox account.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Checks.Desktop</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="page\*" LogicalName="page/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
</Project>
