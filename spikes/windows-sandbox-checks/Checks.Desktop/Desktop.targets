<Project>
  <!--
    NativeAOT links the WebView2 loader statically (one exe). A CoreCLR run loads WebView2Loader.dll from beside the
    app, so it is copied to the build output only.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <_ChecksWebView2Native>$(PkgMicrosoft_Web_WebView2)\build\native\x64\</_ChecksWebView2Native>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <None Include="$(_ChecksWebView2Native)WebView2Loader.dll" Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="WebView2Loader" />
    <NativeLibrary Include="$(_ChecksWebView2Native)WebView2LoaderStatic.lib" />
  </ItemGroup>
</Project>
