<Project Sdk="Spar.Sdk">
  <!--
    Spike (plan, M3; decision "M3's decide-first questions", item 5): how a page receives and sends binary data, as a
    byte[] in a bridge message (base64 in the JSON) against the same bytes fetched from the app's own origin, which is
    the path an opaque handle (/_spar/blob/<id>) would take. Throwaway; RESULTS.md has what it found.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SparAppId>com.example.BinaryDataSpike</SparAppId>
  </PropertyGroup>
</Project>
