<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A desktop app: no console window on Windows (WinExe is the same as Exe elsewhere). -->
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>SampleApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spar.Mini\Spar.Mini.csproj" />
    <InternalsVisibleTo Include="SampleApp.Tests" />
    <InternalsVisibleTo Include="SampleApp.AotTests" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="spar/app/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- Production: the test-host hook is off, and the trimmer removes it (checked by the boundary test). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Spar.TestHost.IsSupported" Value="$(SparTestHostSupported)" Trim="true" />
  </ItemGroup>
  <PropertyGroup>
    <SparTestHostSupported Condition="'$(SparTestHostSupported)' == ''">false</SparTestHostSupported>
  </PropertyGroup>

  <Import Project="..\WebView2Loader.targets" />
</Project>
