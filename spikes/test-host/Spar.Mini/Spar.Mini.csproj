<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A stand-in for the Spar runtime, just large enough to test the test-host design: SparApplication.Create and Run,
    folders under one data root, Spar-owned outward services, external dependencies, a bridge with a hand-written
    stand-in for the generated dispatch, and the two native window hosts (WebView2 and WebKitGTK 6.0).
  -->
  <PropertyGroup>
    <RootNamespace>Spar</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <DefineConstants>$(DefineConstants);SPAR_GTK4</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <InternalsVisibleTo Include="Spar.Mini.Testing" />
    <InternalsVisibleTo Include="SampleApp.Tests" />
    <InternalsVisibleTo Include="SampleApp.AotTests" />
  </ItemGroup>

  <!-- Interop declarations already checked by earlier spikes, linked rather than copied. -->
  <ItemGroup>
    <Compile Include="..\..\react\React.Desktop\Interop\WebView2.cs" Link="Windows\Interop\WebView2.cs" />
    <Compile Include="..\..\react\React.Desktop\Interop\Handlers.cs" Link="Windows\Interop\Handlers.cs" />
    <Compile Include="..\..\linux-desktop\Linux.Desktop\Native.cs" Link="Linux\Interop\Native.cs" />
  </ItemGroup>

</Project>
