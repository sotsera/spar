<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The NativeAOT lane: the same test sources as SampleApp.Tests (linked, unchanged), built against xunit.v3.aot and
    published with NativeAOT, so the app's real composition, overrides and windows run AOT-compiled. Browser tests are
    left out (Playwright for .NET cannot run under NativeAOT, spikes/test-frameworks).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>SampleApp.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);XUNIT_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\SampleApp\SampleApp.csproj" />
    <ProjectReference Include="..\Spar.Mini.Testing\Spar.Mini.Testing.csproj" />
    <Compile Include="..\SampleApp.Tests\*.cs" Exclude="..\SampleApp.Tests\BrowserTests.cs" LinkBase="Tests" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Spar.TestHost.IsSupported" Value="true" Trim="true" />
  </ItemGroup>

  <Import Project="..\WebView2Loader.targets" />
</Project>
