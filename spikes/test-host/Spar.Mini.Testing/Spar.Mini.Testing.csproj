<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stand-in for Spar's test library: starts the app's own Program.cs inside the test process, applies the test's
    overrides, and puts one of three surfaces in front of the backend (none, loopback for a browser, the real window).
  -->
  <PropertyGroup>
    <RootNamespace>Spar.Testing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Spar.Mini\Spar.Mini.csproj" />
  </ItemGroup>
</Project>
