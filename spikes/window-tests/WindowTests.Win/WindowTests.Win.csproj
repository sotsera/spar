<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Window-test spike (testing.md issues D and I, and blocking the native file chooser). One NativeAOT executable with
    verbs: "profiles" (fresh profiles per test, in-process), "parallel" and "crash" (across test processes), "input"
    (trusted CDP input in an offscreen, never-activated window), "filechooser" (Page.setInterceptFileChooserDialog).
    Interop, window and process pieces are adapted from spikes/webview-profiles and spikes/d8-automation.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spar.WindowTests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../www/**" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
</Project>
