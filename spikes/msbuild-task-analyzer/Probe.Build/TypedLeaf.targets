<Project>
  <!-- Runs TypedParameterProbe in the generated leaves with relative values. Used by scripts/typed-parameters.ps1. -->
  <UsingTask TaskName="Probe.Tasks.TypedParameterProbe" AssemblyFile="$(ProbeTaskAssembly)" Runtime="NET" Condition="'$(ProbeTaskHost)' != 'true'" />
  <UsingTask TaskName="Probe.Tasks.TypedParameterProbe" AssemblyFile="$(ProbeTaskAssembly)" Runtime="NET" TaskFactory="TaskHostFactory" Condition="'$(ProbeTaskHost)' == 'true'" />

  <ItemGroup>
    <ProbeItem Include="obj\a.txt;sub\b.txt" />
  </ItemGroup>

  <Target Name="Build">
    <TypedParameterProbe Root="obj" File="obj\file.txt" Directory="sub" Items="@(ProbeItem)" Flag="true" />
  </Target>
</Project>
