<Project>
  <!-- Builds every generated leaf in parallel. The scripts pass ProbeTaskAssembly and, optionally, ProbeLeafRoot. -->
  <PropertyGroup>
    <ProbeLeafRoot Condition="'$(ProbeLeafRoot)' == ''">obj\leaves</ProbeLeafRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProbeLeafProject Include="$(MSBuildThisFileDirectory)..\$(ProbeLeafRoot)\leaf-*\Leaf.proj" />
  </ItemGroup>

  <Target Name="Build">
    <MSBuild Projects="@(ProbeLeafProject)" BuildInParallel="true" />
  </Target>
</Project>
