<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Rule catalogue: every task here misuses an API on purpose, so the build must report diagnostics instead of failing.
    Spike-only: TreatWarningsAsErrors is off in this project, and only here.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0044;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Each run writes its diagnostics, Info level included, to a SARIF log. -->
  <PropertyGroup Condition="'$(ProbeSarif)' != ''">
    <ErrorLog>$(ProbeSarif),version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.TaskAuthoring.Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <!-- Option probes. Each one is a global config selected by a property, so no .editorconfig is needed. -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="config\all-tasks.globalconfig" Condition="'$(ProbeAllTasks)' == 'true'" />
    <GlobalAnalyzerConfigFiles Include="config\enable-0013.globalconfig" Condition="'$(ProbeEnable0013)' == 'true'" />
    <GlobalAnalyzerConfigFiles Include="config\wrong-option.globalconfig" Condition="'$(ProbeWrongOption)' == 'true'" />
  </ItemGroup>
</Project>
