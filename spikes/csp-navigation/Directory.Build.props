<Project>
  <!-- Inherit the repository policy (warnings as errors, code style), then add spike settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- GTK4 builds of the Linux host (-p:SparGtk=4) keep their own bin/ and obj/, so both variants can exist. -->
  <PropertyGroup Condition="'$(SparGtk)' == '4'">
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/gtk4/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/gtk4/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
