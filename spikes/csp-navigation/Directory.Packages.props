<Project>
  <!-- Repository versions, then the Windows host's packages (already in the local NuGet cache). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup>
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.369" />
  </ItemGroup>
</Project>
