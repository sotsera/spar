<Project>
  <!--
    Imported by the app. NativeAOT links the WebView2 loader statically (one exe). Any CoreCLR run or publication
    (dotnet run, PublishAot=false) loads WebView2Loader.dll from beside the app, so it is copied there.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <_SparWebView2Native>$(PkgMicrosoft_Web_WebView2)\build\native\x64\</_SparWebView2Native>
    <_SparWebView2PublishDll Condition="'$(PublishAot)' == 'true'">Never</_SparWebView2PublishDll>
    <_SparWebView2PublishDll Condition="'$(PublishAot)' != 'true'">PreserveNewest</_SparWebView2PublishDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="$(_SparWebView2Native)WebView2Loader.dll" Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="$(_SparWebView2PublishDll)" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(PublishAot)' == 'true'">
    <DirectPInvoke Include="WebView2Loader" />
    <NativeLibrary Include="$(_SparWebView2Native)WebView2LoaderStatic.lib" />
  </ItemGroup>
</Project>
