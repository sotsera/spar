<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike WebView2 host (and loopback mode) for the CSP and navigation checks. Strict NativeAOT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Csp.Windows</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Csp.Shared/*.cs" LinkBase="Shared" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <AdditionalFiles Include="NativeMethods.txt;NativeMethods.json" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
</Project>
