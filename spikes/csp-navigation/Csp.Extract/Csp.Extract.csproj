<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pre-compile step: runs the generator's analysis on a CSharpCompilation of the app's sources and writes csp.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../Csp.Generator/Csp.Generator.csproj" />
    <ProjectReference Include="../Csp.Runtime/Csp.Runtime.csproj" />
  </ItemGroup>
</Project>
