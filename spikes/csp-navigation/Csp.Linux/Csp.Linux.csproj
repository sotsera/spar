<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike WebKitGTK host. -p:SparGtk=4 builds GTK4 + WebKitGTK 6.0; the default is GTK3 + WebKitGTK 4.1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Csp.Linux</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SparGtk)' == '4'">
    <DefineConstants>$(DefineConstants);SPAR_GTK4</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Csp.Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
