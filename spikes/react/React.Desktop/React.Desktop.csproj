<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike desktop host: Win32 window + WebView2, serving the embedded frontend and the Spar bridge in-process. -->
  <PropertyGroup>
    <RootNamespace>React.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Size probes (spike only): -p:SpikeSizeProbe=SPIKE_NO_ZIP, SPIKE_NO_PROCESS or SPIKE_NO_SHA. -->
    <DefineConstants>$(DefineConstants);$(SpikeSizeProbe)</DefineConstants>
  </PropertyGroup>

  <!-- The self-test drives the page through in-process CDP. Debug builds always have it; Release only on request. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(SparSelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);SPAR_SELFTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="../../d1-pipeline/Spike.Runtime/Spike.Runtime.csproj" />
  </ItemGroup>
</Project>
