    invoke<readonly Note[]>(fingerprint, "notes", "search", request, options?.signal),
  remove: (request: NoteId, options?: CallOptions): Promise<boolean> =>
    invoke<boolean>(fingerprint, "notes", "remove", request, options?.signal),
  count: (options?: CallOptions): Promise<number> =>
    invoke<number>(fingerprint, "notes", "count", undefined, options?.signal),
  echo: (request: Echo, options?: CallOptions): Promise<Echo> =>
    invoke<Echo>(fingerprint, "notes", "echo", request, options?.signal),
} as const;
