import { invoke, stream, subscribe, type CallOptions, type StreamOptions, type SubscriptionEvent } from "../sdk/index.js";

export type { CallOptions, StreamOptions, SubscriptionEvent };

export interface LabStats {
  readonly counter: number;
  readonly rowsProduced: number;
  readonly activeWatches: number;
  readonly workStarted: number;
  readonly workStopped: number;
}

export interface MemoryReport {
  readonly gcHeapBytes: number;
  readonly workingSetBytes: number;
  readonly peakGcHeapBytes: number;
  readonly peakWorkingSetBytes: number;
  readonly cpuMs: number;
}

export interface MonitorEvent {
  readonly sequence: number;
  readonly sentAtMs: number;
  readonly value: number;
  readonly source: string;
}

export interface Row {
  readonly id: number;
  readonly name: string;
  readonly email: string;
  readonly amount: number;
  readonly quantity: number;
  readonly active: boolean;
  readonly createdAt: string;
  readonly category: string;
  readonly score: number;
  readonly note: string | null;
}

export interface RowQuery {
  readonly count: number;
  readonly delayEveryRows: number | null;
  readonly delayMs: number | null;
}

export interface WatchRequest {
  readonly ratePerSecond: number;
  readonly seconds: number | null;
}

export interface WorkRequest {
  readonly durationMs: number;
  readonly tickMs: number;
  readonly honorCancellation: boolean;
}

export const fingerprint = "ad941eadd87873d8";

export const lab = {
  rows: (request: RowQuery, options?: StreamOptions): AsyncIterable<Row> =>
    stream<Row>(fingerprint, "lab", "rows", request, options),
  work: (request: WorkRequest, options?: CallOptions): Promise<number> =>
    invoke<number>(fingerprint, "lab", "work", request, options?.signal),
  ticks: (request: WorkRequest, options?: StreamOptions): AsyncIterable<number> =>
    stream<number>(fingerprint, "lab", "ticks", request, options),
  watch: (request: WatchRequest, options?: StreamOptions): AsyncIterable<SubscriptionEvent<MonitorEvent>> =>
    subscribe<MonitorEvent>(fingerprint, "lab", "watch", request, options),
  stats: (options?: CallOptions): Promise<LabStats> =>
    invoke<LabStats>(fingerprint, "lab", "stats", undefined, options?.signal),
  memoryStart: (options?: CallOptions): Promise<MemoryReport> =>
    invoke<MemoryReport>(fingerprint, "lab", "memoryStart", undefined, options?.signal),
  memoryStop: (options?: CallOptions): Promise<MemoryReport> =>
    invoke<MemoryReport>(fingerprint, "lab", "memoryStop", undefined, options?.signal),
