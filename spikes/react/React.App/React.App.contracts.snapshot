## @spar/sdk/index.ts

// Spar SDK (spike). Do not edit.
const hash = new URLSearchParams(location.hash.slice(1));
const token = hash.get("token") ?? sessionStorage.getItem("spar-token");
if (token) {
  sessionStorage.setItem("spar-token", token);
  if (hash.has("token")) history.replaceState(null, "", location.pathname + location.search);
}

export interface CallOptions {
  readonly signal?: AbortSignal;
}

export interface StreamOptions extends CallOptions {
  /** Items per batch the host sends. */
  readonly batch?: number;
  /** Batches a message channel may have in flight before the page grants more (back-pressure). */
  readonly window?: number;
}

/** What a subscription delivers: events, gaps where the bounded buffer dropped the oldest, and resets after reconnecting. */
export type SubscriptionEvent<T> =
  | { readonly type: "event"; readonly value: T }
  | { readonly type: "gap"; readonly dropped: number }
  | { readonly type: "reset" };

/** The command was refused before it ran: retrying after fixing the cause is safe. */
export class NotExecutedError extends Error {
  readonly code: string;

  constructor(code: string, message: string) {
    super(message);
    this.code = code;
  }
}

/** The page was built from different contracts than the running backend. */
export class ContractMismatchError extends NotExecutedError {}

/** The connection failed, the command failed while running, or a cancellation was not confirmed: it may or may not have had effects. */
export class OutcomeUnknownError extends Error {
  /** lost: the connection dropped. failed: the command threw while running. unconfirmed: a cancel was not confirmed in time. */
  readonly reason: "lost" | "failed" | "unconfirmed";

  constructor(reason: "lost" | "failed" | "unconfirmed", message: string) {
    super(message);
    this.reason = reason;
  }
}

/** The backend confirmed the command stopped because it was cancelled. Effects made before it stopped remain. */
export class CancelledError extends Error {}

export interface SparConfig {
  /** fetch: one POST per call (both hosts). message: the desktop host's postMessage channel. */
  unary: "fetch" | "message";
  /** fetch: one streamed response per call. channel: multiplexed over one message channel, with credits. */
  streams: "fetch" | "channel";
  /** How long to wait for the backend to confirm a cancellation before reporting OutcomeUnknownError. */
  cancelConfirmMs: number;
}

export const config: SparConfig = { unary: "fetch", streams: "channel", cancelConfirmMs: 5000 };

export function configure(changes: Partial<SparConfig>): void {
  Object.assign(config, changes);
}

interface ErrorBody {
  readonly error?: string;
  readonly detail?: string;
}

interface WebViewBridge {
  postMessage(message: string): void;
  addEventListener(type: "message", listener: (event: MessageEvent<unknown>) => void): void;
}

// One protocol message. Host to page: r (result), i (items), e (end), c (cancelled and stopped), n (not executed),
// u (outcome unknown), o (channel open). Local only: lost, timeout.
interface Message {
  readonly kind: string;
  readonly id: string;
  readonly field: string;
  readonly json: string;
}

const webview = (globalThis as { chrome?: { webview?: WebViewBridge } }).chrome?.webview;
const documentId = Math.random().toString(36).slice(2) + Date.now().toString(36);
const auth: Record<string, string> = token ? { "Authorization": `Bearer ${token}` } : {};
let nextId = 0;

function parse(text: string): Message {
  let at = 2;
  const take = (): string => {
    const end = text.indexOf(" ", at);
    const value = end < 0 ? text.slice(at) : text.slice(at, end);
    at = end < 0 ? text.length : end + 1;
    return value;
  };

  const kind = text.charAt(0);
  const id = take();
  const field = kind === "i" || kind === "n" || kind === "u" ? take() : "";
  return { kind, id, field, json: text.slice(at) };
}

function local(kind: "lost" | "timeout", id: string): Message {
  return { kind, id, field: "", json: "" };
}

function errorBody(json: string): ErrorBody {
  try {
    return JSON.parse(json) as ErrorBody;
  } catch {
    return {};
  }
}

function toError(message: Message, what: string): Error {
  const body = errorBody(message.json);
  switch (message.kind) {
    case "c":
      return new CancelledError(`${what} was cancelled; the backend confirmed it stopped.`);
    case "n":
      if (message.field === "contract-mismatch") {
        dispatchEvent(new CustomEvent("spar:contract-mismatch"));
        return new ContractMismatchError(message.field, "The app was rebuilt with different contracts. Reload the page.");
      }

      return new NotExecutedError(message.field, `${message.field}: ${body.detail ?? ""}`.trim());
    case "u":
      return new OutcomeUnknownError("failed", `${what} failed while running: ${body.detail ?? message.field}`);
    case "timeout":
      return new OutcomeUnknownError("unconfirmed",
        `${what}: cancellation was requested, but the backend did not confirm it stopped within ${config.cancelConfirmMs} ms.`);
    default:
      return new OutcomeUnknownError("lost", `${what} lost its connection.`);
  }
}

// ---- Channels: ordered messages both ways ----

interface Channel {
  /** Resolves once replies to messages sent from now on can arrive. */
  open(): Promise<void>;
  send(message: string): void;
  listen(id: string, handler: (message: Message) => void): void;
  unlisten(id: string): void;
}

/** Desktop: the WebView2 postMessage channel. It lives as long as the document. */
class DesktopChannel implements Channel {
  readonly #bridge: WebViewBridge;
  readonly #handlers = new Map<string, (message: Message) => void>();

  constructor(bridge: WebViewBridge) {
    this.#bridge = bridge;
    bridge.addEventListener("message", event => {
      if (typeof event.data !== "string") return;
      const message = parse(event.data);
      this.#handlers.get(message.id)?.(message);
    });
    bridge.postMessage(`h ${documentId}`);
  }

  open(): Promise<void> {
    return Promise.resolve();
  }

  send(message: string): void {
    this.#bridge.postMessage(message);
  }

  listen(id: string, handler: (message: Message) => void): void {
    this.#handlers.set(id, handler);
  }

  unlisten(id: string): void {
    this.#handlers.delete(id);
  }
}

/** Loopback: one long-lived streamed response down (all streams of this document), POSTs up. */
class HttpChannel implements Channel {
  readonly #handlers = new Map<string, (message: Message) => void>();
  #opened: Promise<void> | undefined;
  #outbox: string[] = [];
  #flushing = false;

  open(): Promise<void> {
    this.#opened ??= this.#connect().catch((error: unknown) => {
      this.#opened = undefined;
      throw error instanceof NotExecutedError ? error : new NotExecutedError("unavailable", `The backend is not reachable: ${String(error)}`);
    });
    return this.#opened;
  }

  send(message: string): void {
    this.#outbox.push(message);
    if (this.#flushing) return;
    this.#flushing = true;
    queueMicrotask(() => {
      const body = this.#outbox.join("\n");
      this.#outbox = [];
      this.#flushing = false;
      void fetch("/_spar/send", { method: "POST", headers: { ...auth, "X-Spar-Document": documentId }, body }).catch(() => undefined);
    });
  }

  listen(id: string, handler: (message: Message) => void): void {
    this.#handlers.set(id, handler);
  }

  unlisten(id: string): void {
    this.#handlers.delete(id);
  }

  async #connect(): Promise<void> {
    const response = await fetch("/_spar/channel", { method: "POST", headers: { ...auth, "X-Spar-Document": documentId } });
    if (!response.ok || !response.body) {
      throw new NotExecutedError("unavailable", `The message channel was refused: ${response.status}`);
    }

    const lines = readLines(response.body);
    const first = await lines.next();
    if (first.done || !first.value.startsWith("o ")) {
      throw new NotExecutedError("unavailable", "The message channel closed while opening.");
    }

    void this.#receive(lines);
  }

  async #receive(lines: AsyncGenerator<string>): Promise<void> {
    try {
      for await (const line of lines) {
        const message = parse(line);
        this.#handlers.get(message.id)?.(message);
      }
    } catch {
      // The connection dropped: handled below like an ordinary end.
    }

    // Every call still waiting on this channel has lost its connection; the next stream reconnects.
    this.#opened = undefined;
    for (const [id, handler] of [...this.#handlers]) handler(local("lost", id));
  }
}

const desktop = webview ? new DesktopChannel(webview) : undefined;
const http = new HttpChannel();

/** The channel for streams and subscriptions in "channel" mode. */
async function messageChannel(): Promise<Channel> {
  const channel = desktop ?? http;
  await channel.open();
  return channel;
}

/** Cancel messages go up the cheapest way: postMessage on the desktop, a POST on loopback. */
function uplink(): Channel {
  return desktop ?? http;
}

async function* readLines(body: ReadableStream<Uint8Array>): AsyncGenerator<string> {
  const reader = body.getReader();
  const decoder = new TextDecoder();
  let buffered = "";
  try {
    while (true) {
      const { value, done } = await reader.read();
      if (done) return;
      buffered += decoder.decode(value, { stream: true });
      let start = 0;
      let newline = buffered.indexOf("\n");
      while (newline >= 0) {
        yield buffered.slice(start, newline);
        start = newline + 1;
        newline = buffered.indexOf("\n", start);
      }

      buffered = buffered.slice(start);
    }
  } finally {
    void reader.cancel().catch(() => undefined);
  }
}

// ---- Unary calls ----

/**
 * Settles with the real outcome. After an abort, it sends a cancel and keeps waiting for the backend's answer:
 * the result if the command completed anyway, CancelledError if it confirmed it stopped, or OutcomeUnknownError
 * if no answer arrives within config.cancelConfirmMs.
 */
function confirmAfterAbort(work: Promise<Message>, signal: AbortSignal | undefined, cancel: () => void, id: string): Promise<Message> {
  if (!signal) return work;
  return new Promise<Message>((resolve, reject) => {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const onAbort = () => {
      cancel();
      timer = setTimeout(() => resolve(local("timeout", id)), config.cancelConfirmMs);
    };
    signal.addEventListener("abort", onAbort, { once: true });
    work.then(
      message => {
        clearTimeout(timer);
        signal.removeEventListener("abort", onAbort);
        resolve(message);
      },
      (error: unknown) => {
        clearTimeout(timer);
        signal.removeEventListener("abort", onAbort);
        reject(error);
      });
  });
}

async function fetchUnary(fingerprint: string, id: string, contract: string, command: string, body: string): Promise<Message> {
  let response: Response;
  try {
    response = await fetch(`/_spar/call/${contract}/${command}`, {
      method: "POST",
      headers: {
        ...auth,
        "X-Spar-Contracts": fingerprint,
        "X-Spar-Call": id,
        "X-Spar-Document": documentId,
        "Content-Type": "application/json",
      },
      body,
    });
  } catch {
    return local("lost", id);
  }

  const text = await response.text().catch(() => "");
  if (response.ok) return { kind: "r", id, field: "", json: text };
  const code = errorBody(text).error ?? String(response.status);
  if (response.status === 499) return { kind: "c", id, field: code, json: text };
  if ([400, 401, 403, 404, 409].includes(response.status)) return { kind: "n", id, field: code, json: text };
  return { kind: "u", id, field: code, json: text };
}

export async function invoke<T>(fingerprint: string, contract: string, command: string, request: unknown, signal?: AbortSignal): Promise<T> {
  const what = `${contract}.${command}`;
  if (signal?.aborted) throw new NotExecutedError("cancelled", `${what} was cancelled before it was sent.`);

  const id = String(++nextId);
  const body = request === undefined ? "" : JSON.stringify(request);
  const cancel = () => uplink().send(`x ${id}`);
  let reply: Promise<Message>;
  if (config.unary === "message" && desktop) {
    const channel = desktop;
    reply = new Promise<Message>(resolve => channel.listen(id, resolve));
    channel.send(`q ${id} ${contract} ${command} ${fingerprint} ${body}`);
    reply = reply.finally(() => channel.unlisten(id));
  } else {
    reply = fetchUnary(fingerprint, id, contract, command, body);
  }

  const message = await confirmAfterAbort(reply, signal, cancel, id);
  if (message.kind === "r") return JSON.parse(message.json) as T;
  throw toError(message, what);
}

// ---- Streams and subscriptions ----

interface Batch {
  readonly items: readonly unknown[];
  readonly dropped: number;
}

/** One open stream on either transport: batches in order, then exactly one terminal message. */
class StreamCall {
  readonly #what: string;
  readonly #id: string;
  readonly #queue: Batch[] = [];
  #pull: (() => Promise<void>) | undefined;
  #pulling: Promise<void> | undefined;
  #consumed: () => void = () => undefined;
  #sendCancel: () => void = () => undefined;
  #release: () => void = () => undefined;
  #terminal: Message | undefined;
  #wake: (() => void) | undefined;
  #deadline: Promise<void> | undefined;

  constructor(what: string, id: string) {
    this.#what = what;
    this.#id = id;
  }

  attach(pull: (() => Promise<void>) | undefined, consumed: () => void, sendCancel: () => void, release: () => void): void {
    this.#pull = pull;
    this.#consumed = consumed;
    this.#sendCancel = sendCancel;
    this.#release = release;
  }

  receive(message: Message): void {
    if (this.#terminal) return;
    if (message.kind === "i") {
      // After a cancel, items still in flight are dropped: the caller asked to stop.
      if (!this.#deadline) this.#queue.push({ items: JSON.parse(message.json) as unknown[], dropped: Number(message.field) });
    } else {
      this.#terminal = message;
      this.#release();
    }

    this.#wakeUp();
  }

  /** Sends one cancel; the outcome arrives as the terminal message, or as a timeout. */
  cancel(): void {
    if (this.#deadline || this.#terminal) return;
    this.#queue.length = 0;
    this.#deadline = new Promise<void>(resolve => setTimeout(() => {
      if (!this.#terminal) {
        this.#terminal = local("timeout", this.#id);
        this.#release();
      }

      resolve();
    }, config.cancelConfirmMs));
    this.#sendCancel();
    this.#wakeUp();
  }

  /** The next batch, or null when the stream completed. Rejects with the stream's failure or cancellation. */
  async next(): Promise<Batch | null> {
    while (true) {
      const batch = this.#queue.shift();
      if (batch) {
        this.#consumed();
        return batch;
      }

      if (this.#terminal) {
        if (this.#terminal.kind === "e") return null;
        throw toError(this.#terminal, this.#what);
      }

      await this.#waitForMessage();
    }
  }

  /** The consumer stopped early: cancel and wait until the backend confirms (or the confirmation times out). */
  async close(): Promise<void> {
    this.cancel();
    while (!this.#terminal) await this.#waitForMessage();
    if (this.#terminal.kind !== "c" && this.#terminal.kind !== "e") throw toError(this.#terminal, this.#what);
  }

  async #waitForMessage(): Promise<void> {
    const waits: Promise<void>[] = [new Promise<void>(resolve => { this.#wake = resolve; })];
    if (this.#pull) {
      this.#pulling ??= this.#pull().finally(() => { this.#pulling = undefined; });
      waits.push(this.#pulling);
    }

    if (this.#deadline) waits.push(this.#deadline);
    await Promise.race(waits);
  }

  #wakeUp(): void {
    const wake = this.#wake;
    this.#wake = undefined;
    wake?.();
  }
}

async function openStream(fingerprint: string, contract: string, command: string, request: unknown, options: StreamOptions): Promise<StreamCall> {
  const what = `${contract}.${command}`;
  if (options.signal?.aborted) throw new NotExecutedError("cancelled", `${what} was cancelled before it was sent.`);

  const id = String(++nextId);
  const body = request === undefined ? "" : JSON.stringify(request);
  const batch = options.batch ?? 100;
  const call = new StreamCall(what, id);
  if (config.streams === "channel") {
    const channel = await messageChannel();
    const window = options.window ?? 8;
    const grant = Math.max(1, window >> 1);
    let consumed = 0;
    call.attach(
      undefined,
      () => {
        if (++consumed < grant) return;
        channel.send(`k ${id} ${consumed}`);
        consumed = 0;
      },
      () => channel.send(`x ${id}`),
      () => channel.unlisten(id));
    channel.listen(id, message => call.receive(message));
    channel.send(`s ${id} ${contract} ${command} ${fingerprint} ${batch} ${window} ${body}`);
  } else {
    let response: Response;
    try {
      response = await fetch(`/_spar/stream/${contract}/${command}`, {
        method: "POST",
        headers: {
          ...auth,
          "X-Spar-Contracts": fingerprint,
          "X-Spar-Call": id,
          "X-Spar-Document": documentId,
          "X-Spar-Batch": String(batch),
          "Content-Type": "application/json",
        },
        body,
      });
    } catch {
      throw toError(local("lost", id), what);
    }

    if (!response.ok || !response.body) {
      const text = await response.text().catch(() => "");
      const code = errorBody(text).error ?? String(response.status);
      throw toError({ kind: response.status >= 500 ? "u" : "n", id, field: code, json: text }, what);
    }

    // Pull-driven: the response is read only when the consumer needs the next batch, so back-pressure reaches the host.
    const lines = readLines(response.body);
    call.attach(
      async () => {
        try {
          const line = await lines.next();
          call.receive(line.done ? local("lost", id) : parse(line.value));
        } catch {
          call.receive(local("lost", id));
        }
      },
      () => undefined,
      () => uplink().send(`x ${id}`),
      () => void lines.return(undefined));
  }

  options.signal?.addEventListener("abort", () => call.cancel(), { once: true });
  return call;
}

async function* streamItems<T>(fingerprint: string, contract: string, command: string, request: unknown, options: StreamOptions): AsyncGenerator<T> {
  const call = await openStream(fingerprint, contract, command, request, options);
  let settled = false;
  try {
    while (true) {
      const batch = await call.next();
      if (batch === null) {
        settled = true;
        return;
      }

      for (const item of batch.items) yield item as T;
    }
  } catch (error) {
    settled = true;
    throw error;
  } finally {
    if (!settled) await call.close();
  }
}

async function* subscriptionEvents<T>(fingerprint: string, contract: string, command: string, request: unknown, options: StreamOptions): AsyncGenerator<SubscriptionEvent<T>> {
  const call = await openStream(fingerprint, contract, command, request, options);
  let settled = false;
  try {
    while (true) {
      const batch = await call.next();
      if (batch === null) {
        settled = true;
        return;
      }

      if (batch.dropped > 0) yield { type: "gap", dropped: batch.dropped };
      for (const item of batch.items) yield { type: "event", value: item as T };
    }
  } catch (error) {
    settled = true;
    throw error;
  } finally {
    if (!settled) await call.close();
  }
}

/**
 * Runs a streaming command. Iteration starts the command; breaking out of the loop cancels it and waits for the
 * backend to confirm it stopped. Aborting the signal makes the loop throw CancelledError once the backend confirms,
 * or OutcomeUnknownError if it does not confirm in time. Nothing is ever retried.
 */
export function stream<T>(fingerprint: string, contract: string, command: string, request: unknown, options: StreamOptions = {}): AsyncIterable<T> {
  return { [Symbol.asyncIterator]: () => streamItems<T>(fingerprint, contract, command, request, options) };
}

/** Runs a subscription: events from a bounded buffer that drops the oldest and reports each gap. */
export function subscribe<T>(fingerprint: string, contract: string, command: string, request: unknown, options: StreamOptions = {}): AsyncIterable<SubscriptionEvent<T>> {
  return { [Symbol.asyncIterator]: () => subscriptionEvents<T>(fingerprint, contract, command, request, options) };
}

/**
 * Opt-in re-subscription for read-only subscriptions: when the connection is lost (a backend restart in a
 * development session), waits and subscribes again, yielding a "reset" before the first event of the new subscription.
 * The SDK never does this on its own; the app chooses it per subscription.
 */
export async function* keepSubscribed<T>(
  open: () => AsyncIterable<SubscriptionEvent<T>>,
  options: { readonly signal?: AbortSignal; readonly retryMs?: number } = {}): AsyncGenerator<SubscriptionEvent<T>> {
  let reconnecting = false;
  while (!options.signal?.aborted) {
    try {
      for await (const event of open()) {
        if (reconnecting) {
          reconnecting = false;
          yield { type: "reset" };
        }

        yield event;
      }

      return;
    } catch (error) {
      const lost = (error instanceof OutcomeUnknownError && error.reason === "lost") || (error instanceof NotExecutedError && error.code === "unavailable");
      if (!lost || options.signal?.aborted) throw error;
    }

    reconnecting = true;
    await new Promise(resolve => setTimeout(resolve, options.retryMs ?? 250));
  }
}

/** Tells the host the UI is wired and can accept input. */
export async function ready(): Promise<void> {
  await fetch("/_spar/ready", { method: "POST", headers: auth });
}

