<Project>
  <!--
    React/Vite frontend, after the generated client exists:
      SparNpmCi               npm ci when package-lock.json changed (npm's own node_modules/.package-lock.json is the output)
      SparLinkClientPackages  node_modules/@spar -> obj/.../spar/client/packages/@spar (junction), when missing
      SparBuildFrontend       tsc type-check + vite build into obj/.../spar/frontend-dist, only when sources or the
                              generated packages changed (they are written only when their content changes)
      SparPackFrontend        packs frontend-dist (SparPackDirectories) into the embedded zip
  -->
  <Target Name="SparFrontendPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SparFrontendOut>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'spar', 'frontend-dist'))</_SparFrontendOut>
      <_SparClientPackages>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'spar', 'client', 'packages', '@spar'))</_SparClientPackages>
      <_SparLinkedPackages>$([MSBuild]::NormalizePath('$(SparFrontendPath)', 'node_modules', '@spar'))</_SparLinkedPackages>
      <SparPackDirectories>$(_SparFrontendOut)</SparPackDirectories>
    </PropertyGroup>
    <ItemGroup>
      <_SparClientPackageFile Include="$(_SparClientPackages)**/*" />
    </ItemGroup>
  </Target>

  <Target Name="SparNpmCi" DependsOnTargets="SparFrontendPaths" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(SparFrontendPath)package-lock.json" Outputs="$(SparFrontendPath)node_modules/.package-lock.json">
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(SparFrontendPath)" />
  </Target>

  <!--
    Junctions and symlinks store an absolute target. A marker records it, so a moved or re-cloned repository
    (where the old link would point at the previous location) gets the link recreated instead of silently stale.
  -->
  <Target Name="SparLinkClientPackages" DependsOnTargets="SparNpmCi" Condition="'$(DesignTimeBuild)' != 'true' and '$(SparLinkPackages)' != 'false'">
    <PropertyGroup>
      <_SparLinkTarget>$(_SparClientPackages.TrimEnd('\').TrimEnd('/'))</_SparLinkTarget>
      <_SparLinkMarker>$(SparFrontendPath)node_modules/.spar-link</_SparLinkMarker>
      <_SparLinkedTarget />
    </PropertyGroup>
    <ReadLinesFromFile File="$(_SparLinkMarker)" Condition="Exists('$(_SparLinkMarker)')">
      <Output TaskParameter="Lines" PropertyName="_SparLinkedTarget" />
    </ReadLinesFromFile>

    <Exec Condition="Exists('$(_SparLinkedPackages)') and '$(_SparLinkedTarget)' != '$(_SparLinkTarget)' and '$(OS)' == 'Windows_NT'"
          Command="cmd /c rmdir &quot;$(_SparLinkedPackages)&quot;" />
    <Exec Condition="Exists('$(_SparLinkedPackages)') and '$(_SparLinkedTarget)' != '$(_SparLinkTarget)' and '$(OS)' != 'Windows_NT'"
          Command="rm &quot;$(_SparLinkedPackages)&quot;" />

    <Exec Condition="!Exists('$(_SparLinkedPackages)') and '$(OS)' == 'Windows_NT'"
          Command="cmd /c mklink /J &quot;$(_SparLinkedPackages)&quot; &quot;$(_SparLinkTarget)&quot;" StandardOutputImportance="low" />
    <Exec Condition="!Exists('$(_SparLinkedPackages)') and '$(OS)' != 'Windows_NT'"
          Command="ln -s &quot;$(_SparLinkTarget)&quot; &quot;$(_SparLinkedPackages)&quot;" />
    <WriteLinesToFile File="$(_SparLinkMarker)" Lines="$(_SparLinkTarget)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Spike: the measurement page (bench.html) is bundled only into Debug and self-test builds, never production. -->
  <Target Name="SparFrontendVariant" DependsOnTargets="SparFrontendPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SparBench>0</_SparBench>
      <_SparBench Condition="'$(Configuration)' == 'Debug' or '$(SparSelfTest)' == 'true'">1</_SparBench>
      <_SparFrontendVariant>$(IntermediateOutputPath)spar/frontend.variant</_SparFrontendVariant>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)spar" />
    <WriteLinesToFile File="$(_SparFrontendVariant)" Lines="bench=$(_SparBench)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="SparBuildFrontend" AfterTargets="SparGenerateClient" BeforeTargets="SparPackFrontend"
          DependsOnTargets="SparFrontendPaths;SparFrontendVariant;SparNpmCi;SparLinkClientPackages" Condition="'$(DesignTimeBuild)' != 'true' and '$(SparDevServerBuild)' != 'true'"
          Inputs="@(_SparFrontendInput);@(_SparClientPackageFile);$(SparFrontendPath)package-lock.json;$(_SparFrontendVariant)"
          Outputs="$(_SparFrontendOut)index.html">
    <Exec Command="npm run build -- --outDir &quot;$(_SparFrontendOut.TrimEnd('\').TrimEnd('/'))&quot; --emptyOutDir" WorkingDirectory="$(SparFrontendPath)"
          EnvironmentVariables="SPAR_BENCH=$(_SparBench)" />
    <Touch Files="$(_SparFrontendOut)index.html" />
  </Target>

  <Target Name="SparFrontendPackInputs" AfterTargets="SparBuildFrontend" BeforeTargets="SparPackFrontend"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SparDevServerBuild)' != 'true'">
    <ItemGroup>
      <SparPackInput Include="$(_SparFrontendOut)**/*" />
    </ItemGroup>
  </Target>

  <!--
    With SparDevServerBuild=true (pass it to dotnet watch as a property) the Vite dev server serves the
    frontend, so the production bundle is skipped and a placeholder page is embedded. The type-check still runs unless
    SparDevTypeCheck=false. dotnet watch (SDK 11.0.100) sets no property or variable that marks its builds, so the
    caller has to choose.
  -->

  <Target Name="SparDevPlaceholder" AfterTargets="SparGenerateClient" BeforeTargets="SparPackFrontend"
          DependsOnTargets="SparFrontendPaths" Condition="'$(SparDevServerBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SparDevPlaceholder>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'spar', 'dev-placeholder'))</_SparDevPlaceholder>
      <SparPackDirectories>$(_SparDevPlaceholder)</SparPackDirectories>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SparDevPlaceholder)index.html" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;!doctype html&gt;&lt;title&gt;Development build&lt;/title&gt;&lt;p&gt;This development build has no packaged frontend: open the dev server address printed by the app.&lt;/p&gt;" />
    <ItemGroup>
      <SparPackInput Include="$(_SparDevPlaceholder)index.html" />
    </ItemGroup>
  </Target>

  <Target Name="SparDevTypeCheck" AfterTargets="SparGenerateClient" BeforeTargets="SparPackFrontend"
          DependsOnTargets="SparFrontendPaths;SparNpmCi;SparLinkClientPackages"
          Condition="'$(SparDevServerBuild)' == 'true' and '$(SparDevTypeCheck)' != 'false' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(_SparFrontendInput);@(_SparClientPackageFile);$(SparFrontendPath)package-lock.json"
          Outputs="$(IntermediateOutputPath)spar/frontend.typecheck.stamp">
    <Exec Command="&quot;node_modules/.bin/tsc&quot; --noEmit -p ." WorkingDirectory="$(SparFrontendPath)" />
    <Touch Files="$(IntermediateOutputPath)spar/frontend.typecheck.stamp" AlwaysCreate="true" />
  </Target>
</Project>
