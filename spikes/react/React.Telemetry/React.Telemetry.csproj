<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike of the optional OpenTelemetry layer: referenced only when the app opts in (SparTelemetry=true). -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Size probes (spike only): SPIKE_NO_LOGS, SPIKE_TRACES_ONLY. -->
    <DefineConstants>$(DefineConstants);$(SpikeSizeProbe)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
</Project>
