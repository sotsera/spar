<Project Sdk="Microsoft.NET.Sdk">
  <!-- The React spike's backend (copied contract sources) hosted by the Linux desktop host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>React.App</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SpikeSerializer>Spar</SpikeSerializer>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SpikeSerializer" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../d1-pipeline/Spike.Generator/Spike.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../d1-pipeline/Spike.Runtime/Spike.Runtime.csproj" />
    <ProjectReference Include="../Linux.Desktop/Linux.Desktop.csproj" />
  </ItemGroup>

  <!-- Optional OpenTelemetry layer: -p:SparTelemetry=true. Off by default; the bundle must be built with it too. -->
  <ItemGroup Condition="'$(SparTelemetry)' == 'true'">
    <ProjectReference Include="../../react/React.Telemetry/React.Telemetry.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SparTelemetry)' == 'true'">
    <DefineConstants>$(DefineConstants);SPAR_TELEMETRY</DefineConstants>
  </PropertyGroup>

  <!--
    The React spike's built bundle (Debug variant: index.html plus bench.html), copied as files and embedded one
    resource per file. Spike shortcut: no zip, no build of the frontend here.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../frontend-dist/**/*" LogicalName="spar/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
