<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Theme start-up spike, Windows host: a Win32 window and WebView2 with each theme layer behind a switch, an in-process
    frame capture (PrintWindow with PW_RENDERFULLCONTENT), and a page served from the built frontend folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Theme.Desktop</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Import Project="Desktop.targets" />
</Project>
