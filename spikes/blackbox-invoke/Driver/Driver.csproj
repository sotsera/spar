<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Invoke spike's driver (../RESULTS.md): launches the probe app (../InvokeProbe) on a desktop of its own and times
    UI Automation's Invoke, LegacyIAccessible's DoDefaultAction and SetFocus against the page's own timestamps, with
    AutoSetFocus on and off, other connection and transaction timeouts, and an MTA thread without a message pump against
    an STA thread that pumps. It compiles the fixture's process, desktop and UI Automation sources by link. Throwaway.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>InvokeDriver</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\Spar.Testing\BlackBox\AppProcess.cs;..\..\..\src\Spar.Testing\BlackBox\CommandLine.cs;..\..\..\src\Spar.Testing\BlackBox\ThreadControl.cs;..\..\..\src\Spar.Testing\BlackBox\HiddenDesktop.cs;..\..\..\src\Spar.Testing\BlackBox\IBlackBoxProcess.cs" LinkBase="Fixture" />
    <Compile Include="..\..\..\src\Spar.Testing\BlackBox\Automation\TopWindows.cs;..\..\..\src\Spar.Testing\BlackBox\Automation\Uia.cs;..\..\..\src\Spar.Testing\BlackBox\Interop\UiAutomation.cs" LinkBase="Fixture" />
    <AdditionalFiles Include="..\..\..\src\Spar.Testing\NativeMethods.txt;..\..\..\src\Spar.Testing\NativeMethods.json" />
  </ItemGroup>
</Project>
