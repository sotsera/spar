<Project Sdk="Spar.Sdk">
  <!--
    The Invoke spike's probe app (../RESULTS.md): a Spar app published Production NativeAOT, whose page timestamps every
    pointer, mouse, focus and click event it sees, and its frame and timer rates, and sends each line to the backend,
    which writes it to standard error with its own clock. Throwaway.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>InvokeProbe</RootNamespace>
    <SparAppId>com.example.spikes.InvokeProbe</SparAppId>
    <SparTypeCheck>false</SparTypeCheck>
  </PropertyGroup>
</Project>
