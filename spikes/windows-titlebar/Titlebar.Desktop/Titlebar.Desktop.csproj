<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Custom title bar spike, Windows host: a Win32 window with a standard or custom frame, WebView2 hosted windowed or
    through visual hosting (composition controller), host-side hit-test probes, and a static page embedded in the exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Titlebar.Desktop</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Size measurement only: standard = no custom frame, no visual hosting; windowed = custom frame, no visual hosting. -->
  <PropertyGroup>
    <DefineConstants Condition="'$(TitlebarVariant)' == 'standard'">$(DefineConstants);TITLEBAR_NO_CUSTOM;TITLEBAR_NO_VISUAL</DefineConstants>
    <DefineConstants Condition="'$(TitlebarVariant)' == 'windowed'">$(DefineConstants);TITLEBAR_NO_VISUAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="page\*" LogicalName="page/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="Desktop.targets" />
</Project>
